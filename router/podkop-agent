#!/bin/sh
# shellcheck shell=dash disable=SC1090,SC1091,SC2012,SC2016,SC2034,SC2317,SC2329
#
# podkop-agent — runs on the OpenWrt router next to podkop and does what
# podkop-manager asks over SSH: read and change podkop's settings safely
# (check, write, restart, health check, undo), pin servers, run podkop-probe,
# stream events. "podkop-agent daemon" (procd) is a watchdog that keeps
# podkop running and puts pinned servers back after every restart.
#
# The manager's SSH key may run only this program (authorized_keys:
# restrict,command="/usr/bin/podkop-agent"); the command comes in
# $SSH_ORIGINAL_COMMAND, requests come as JSON on stdin, answers go as JSON to
# stdout: {"v":1,"ok":true,"data":...} or {"v":1,"ok":false,"error":{...}}.

AGENT_VERSION="0.30.0"
PROTO=1
ETC=/etc/podkop-agent
RUN=/tmp/podkop-agent
CFG=/etc/config/podkop
PODKOP_LIB=/usr/lib/podkop
PROBE=/usr/bin/podkop-probe
PROBE_CONF=/etc/podkop-probe.conf     # podkop-probe's own saved keys and settings
EVENTS=$RUN/events.ndjson
TAB=$(printf '\t')
BOOT=$(cut -c 1-8 /proc/sys/kernel/random/boot_id 2>/dev/null || echo 00000000)

set -u
export LC_ALL=C
umask 077

[ ! -f /usr/share/podkop-agent/reliability.sh ] || . /usr/share/podkop-agent/reliability.sh

# --- output -------------------------------------------------------------------

reply() { printf '{"v":%s,"ok":true,"data":%s}\n' "$PROTO" "${1:-null}"; exit 0; }

capabilities() {
  if command -v cmd_diagnostics >/dev/null 2>&1 && command -v cmd_eligibility >/dev/null 2>&1; then
    if command -v heal_check >/dev/null 2>&1; then printf '["diagnostics","eligibility","heal","strict","resolve","upgrade","ipv6","vpn","safe","dns","sections","devices","route","zapret"]'
    else printf '["diagnostics","eligibility","resolve","upgrade","ipv6","vpn","safe","dns","sections","devices","route","zapret"]'; fi
  else printf '["resolve","upgrade","ipv6","vpn","safe","dns","sections","devices","route","zapret"]'; fi
}

# fail <code> <message> [details json]
fail() {
  jq -nc --argjson v "$PROTO" --arg c "$1" --arg m "$2" --argjson d "${3:-null}" \
    '{v: $v, ok: false, error: {code: $c, message: $m, details: $d}}'
  exit 1
}

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# event <type> [json object with more fields]: append to the event log that
# "watch" streams; ids are "<boot>:<n>", so a reboot shows as a new boot
event() {
  mkdir -p "$RUN"
  _ef=${2:-}; [ -n "$_ef" ] || _ef='{}'
  (
    flock 8
    _n=$(( $(cat "$RUN/seq" 2>/dev/null || echo 0) + 1 ))
    echo "$_n" > "$RUN/seq"
    jq -nc --arg id "$BOOT:$_n" --arg t "$(now)" --arg ty "$1" --argjson f "$_ef" \
      '{id: $id, t: $t, type: $ty} + $f' >> "$EVENTS"
    if [ $((_n % 500)) = 0 ]; then   # keep the last 1000 events
      tail -n 1000 "$EVENTS" > "$EVENTS.t" && mv "$EVENTS.t" "$EVENTS"
    fi
  ) 8> "$RUN/events.lock"
}

# --- podkop's settings as JSON ----------------------------------------------------

# {"sections":[{"name","type","anonymous","options":{opt: "value" | ["list", ...]}}]}
# in podkop's order. Read through ubus, which gives lists as arrays.
UBUS2CONF='.values | [.[]] | sort_by(.[".index"])
  | {sections: map({name: .[".name"], type: .[".type"], anonymous: (.[".anonymous"] // false),
                    options: with_entries(select(.key | startswith(".") | not))})}'

# the same shape with every value a string (or array of strings)
NORM='{sections: [.sections[] | {name: (.name | tostring), type: (.type | tostring),
  anonymous: (.anonymous // false),
  options: ((.options // {}) | with_entries(.value |= (if type == "array" then map(tostring) else tostring end)))}]}'

# fingerprint of a config: podkop rewrites settings.shutdown_correctly on every
# start and stop, so it is left out
FP_JQ='(.sections[] | select(.name == "settings") | .options) |= del(.shutdown_correctly)'

# fails (no output) when ubus does not answer, e.g. while rpcd restarts
config_json() {
  _cj=$(ubus call uci get '{"config":"podkop"}' 2>/dev/null) && [ -n "$_cj" ] || return 1
  printf '%s' "$_cj" | jq -c "$UBUS2CONF"
}

# seen_json, seen_fp: the same for the rounds that only look (the daemon
# every 15 s, "status" every 30 s): kept in RAM and read again only after
# podkop's settings file changed (or a change waits uncommitted). The stamp
# is made before the read, so a change during it is seen the next time. An
# apply and its checks always read afresh (config_json, config_fp).
config_seen() {
  if [ -s "$RUN/seen.json" ] && [ "$RUN/seen.stamp" -nt "$CFG" ] &&
     { [ ! -e /tmp/.uci/podkop ] || [ "$RUN/seen.stamp" -nt /tmp/.uci/podkop ]; }; then return 0; fi
  mkdir -p "$RUN"; : > "$RUN/seen.stamp.$$"
  if _sn=$(config_json) && [ -n "$_sn" ] && printf '%s' "$_sn" > "$RUN/seen.json.$$" &&
     printf '%s' "$_sn" | fingerprint > "$RUN/seen.fp.$$"; then
    mv "$RUN/seen.json.$$" "$RUN/seen.json" && mv "$RUN/seen.fp.$$" "$RUN/seen.fp" && mv "$RUN/seen.stamp.$$" "$RUN/seen.stamp"
  else rm -f "$RUN/seen.json.$$" "$RUN/seen.fp.$$" "$RUN/seen.stamp.$$"; return 1; fi
}
seen_json() { config_seen && cat "$RUN/seen.json"; }
seen_fp() { config_seen && cat "$RUN/seen.fp"; }

# config_fp: the fingerprint of podkop's settings now; fails like config_json
config_fp() { _cf=$(config_json) && [ -n "$_cf" ] || return 1; printf '%s' "$_cf" | fingerprint; }
fingerprint() { jq -cS "$FP_JQ" | md5sum | cut -c 1-32; }

# the UCI file for a config
TOUCI=$(cat <<'EOF'
def q: "'" + (split("'") | join("'\\''")) + "'";
.sections[] | "",
  ("config " + .type + (if .anonymous then "" else " " + (.name | q) end)),
  (.options | to_entries[] | .key as $k
    | if (.value | type) == "array" then (.value[] | "\tlist " + $k + " " + q)
      else "\toption " + $k + " " + (.value | q) end)
EOF
)

# --- checks before podkop is touched ----------------------------------------------

# podkop refuses to start (exit 1, proxy and DNS down) on all of these
CHECK_JQ=$(cat <<'EOF'
def err($s; $o; $m): {section: $s, option: $o, message: $m};
def lst: if . == null then [] elif type == "array" then . else [.] end;
($svc | split(" ") | map(select(. != ""))) as $services
| [ (if ([.sections[] | select(.name == "settings" and .type == "settings")] | length) != 1
      then err("settings"; null; "there must be one section of type settings named settings") else empty end),
    (.sections | group_by(.name)[] | select(length > 1) | err(.[0].name; null; "this name is used by two sections")),
    (.sections[] | select(.name == "settings") | .options
      | if ((.dns_type // "udp") | IN("udp", "dot", "doh")) then empty
        else err("settings"; "dns_type"; "must be udp, dot or doh") end),
    (.sections[] | select(.type == "section") | .name as $s | .options as $o
      | ($o.connection_type // "") as $ct
      | (if ($ct | IN("proxy", "vpn", "block", "exclusion") | not)
           then err($s; "connection_type"; "must be proxy, vpn, block or exclusion")
         elif $ct == "proxy" then
           ($o.proxy_config_type // "") as $pt
           | if ($pt | IN("url", "selector", "urltest", "outbound") | not)
               then err($s; "proxy_config_type"; "must be url, selector, urltest or outbound")
             elif $pt == "url" and ($o.proxy_string // "") == "" then err($s; "proxy_string"; "is empty")
             elif $pt == "selector" and ($o.selector_proxy_links | lst | length) == 0
               then err($s; "selector_proxy_links"; "needs at least one link")
             elif $pt == "urltest" and ($o.urltest_proxy_links | lst | length) == 0
               then err($s; "urltest_proxy_links"; "needs at least one link")
             elif $pt == "outbound" and ((($o.outbound_json // "") | try fromjson catch null) | type) != "object"
               then err($s; "outbound_json"; "is not a JSON object")
             else empty end
         elif $ct == "vpn" and ($o.interface // "") == "" then err($s; "interface"; "is empty")
         else empty end),
        ($o.community_lists | lst | .[] | select(IN($services[]) | not)
          | err($s; "community_lists"; "podkop has no list \"\(.)\"")),
        (if ($o.mixed_proxy_enabled // "0") == "1" and ((($o.mixed_proxy_port // "") | tonumber?) // null) == null
           then err($s; "mixed_proxy_port"; "must be a port number") else empty end),
        (if ($o.urltest_tolerance // "") != "" and ((($o.urltest_tolerance | tonumber?) // null) == null)
           then err($s; "urltest_tolerance"; "must be a number") else empty end))
  ]
EOF
)

# the links podkop will parse: section, option, index, link (tab separated)
LINKS_JQ=$(cat <<'EOF'
def lst: if . == null then [] elif type == "array" then . else [.] end;
.sections[] | select(.type == "section" and .options.connection_type == "proxy")
| .name as $s | .options as $o
| (if $o.proxy_config_type == "url" then [[$s, "proxy_string", 0, $o.proxy_string]]
   elif $o.proxy_config_type == "selector" then [$o.selector_proxy_links | lst | to_entries[] | [$s, "selector_proxy_links", .key, .value]]
   elif $o.proxy_config_type == "urltest" then
     [($o.urltest_proxy_links | lst | to_entries[] | [$s, "urltest_proxy_links", .key, .value]),
      ($o.urltest_fallback_links | lst | to_entries[] | [$s, "urltest_fallback_links", .key, .value])]
   else [] end)[] | @tsv
EOF
)

# check_links < tsv: each link through podkop's own parser -> error objects
check_links() (
  set +u
  . "$PODKOP_LIB/sing_box_config_facade.sh"
  log() { case "$2" in error|fatal) printf '%s\n' "$1" >> "$RUN/chk.$$.err" ;; esac; }
  while IFS="$TAB" read -r _s _o _i _l; do
    rm -f "$RUN/chk.$$.err"
    ( sing_box_cf_add_proxy_outbound '{"outbounds":[]}' chk "$_l" 0 ) > "$RUN/chk.$$.out" 2>/dev/null
    if [ -s "$RUN/chk.$$.err" ] || ! jq -e '.outbounds[0]' "$RUN/chk.$$.out" >/dev/null 2>&1; then
      jq -nc --arg s "$_s" --arg o "$_o" --argjson i "$_i" \
        --arg m "$(head -n 1 "$RUN/chk.$$.err" 2>/dev/null | sed 's/ Aborted\.$//')" \
        '{section: $s, option: $o, index: $i, message: (if $m == "" then "podkop cannot read this link" else $m end)}'
    fi
  done
  rm -f "$RUN/chk.$$.err" "$RUN/chk.$$.out"
)

# check_outbounds <config file>: outbound_json of each section through sing-box check;
# it may name the outbounds of other sections (a selector of main-out), here stand-ins
check_outbounds() {
  jq -r '.sections[] | select(.type == "section" and .options.connection_type == "proxy"
           and .options.proxy_config_type == "outbound") | .name' "$1" |
  while IFS= read -r _s; do
    jq -c --arg s "$_s" '{log: {disabled: true},
        outbounds: ([.sections[] | select(.name == $s) | .options.outbound_json | fromjson | .tag = "x"]
          + [.sections[] | select(.type == "section" and .name != $s) | .name
             | ("\(.)-out", "\(.)-urltest-out") | {type: "direct", tag: .}])}' \
      "$1" > "$RUN/chk.$$.json"
    if ! _m=$(sing-box check -c "$RUN/chk.$$.json" 2>&1); then
      jq -nc --arg s "$_s" --arg m "$(printf '%s' "$_m" | tail -n 1)" \
        '{section: $s, option: "outbound_json", message: ("sing-box: " + $m)}'
    fi
  done
  rm -f "$RUN/chk.$$.json"
}

community_lists() ( set +u; . "$PODKOP_LIB/constants.sh" 2>/dev/null; printf '%s' "${COMMUNITY_SERVICES:-}" )

# validate <config file> -> JSON array of problems ([] = fine)
validate() {
  _svc=$(community_lists)
  {
    jq -c --arg svc "$_svc" "$CHECK_JQ | .[]" "$1"
    jq -r "$LINKS_JQ" "$1" | check_links
    check_outbounds "$1"
  } | jq -sc '.'
}

# names that go into the UCI file unquoted must be plain words
check_names() {
  jq -r '.sections[] | .type, (if .anonymous then empty else .name end), (.options | keys_unsorted[])' "$1" |
  while IFS= read -r _w; do
    case "$_w" in ""|*[!A-Za-z0-9_]*) printf '%s\n' "$_w"; return ;; esac
  done
}

# --- podkop's state ------------------------------------------------------------

# podkop_start_state: running (its start is still going), none, or the exit code
podkop_start_state() {
  ubus call service list '{"name":"podkop"}' 2>/dev/null | jq -r '[.podkop.instances[]?]
    | if length == 0 then "none" elif any(.running) then "running"
      else (map(.exit_code // 0) | max | tostring) end'
}

# the engine's failsafe writes why it stopped podkop; only a fresh note matters
failsafe_recent() {
  find /etc/sing-box/failsafe.last -mmin -10 2>/dev/null | grep -q . && tail -n 1 /etc/sing-box/failsafe.last
}

# (what "/etc/init.d/podkop enabled" looks at, without starting a script:
# the daemon asks every round)
podkop_enabled() {
  for _pe in /etc/rc.d/S[0-9][0-9]podkop; do [ -e "$_pe" ] && return 0; done
  return 1
}
# the sing-box procd runs: `sing-box check`, the exit-IP check and the probe
# run sing-box processes too
singbox_pid() {
  ubus call service list '{"name":"sing-box"}' 2>/dev/null |
    jq -r '[.["sing-box"].instances[]? | select(.running) | .pid] | first // empty'
}
# straight from sing-box's API (one curl); podkop's own command, a script
# that starts for every call, only without our helper
proxies() {
  if command -v clash_get >/dev/null 2>&1; then clash_get /proxies 2>/dev/null
  else podkop clash_api get_proxies 2>/dev/null; fi
}

# proxies_json: the groups and servers of the Clash API, as "proxies" answers
# them; nothing on stdout when the API does not answer
proxies_json() {
  _p=$(proxies); [ -n "$_p" ] || return 1
  printf '%s' "$_p" | jq -c '.proxies | {
      groups: [to_entries[] | select(.value.all != null and .key != "GLOBAL")
               | {name: .key, type: .value.type, now: .value.now, all: .value.all}],
      servers: [to_entries[] | select(.value.all == null)
                | {name: .key, type: .value.type, delay: ((.value.history // []) | last | .delay // null)}]}'
}

# static_json: what "status" tells about the router and the installed programs;
# read once and kept in RAM until one of the programs (or the agent) changes,
# so a status call does not start sing-box and podkop every 30 s
static_json() {
  _sj="$RUN/static.json"; _sb=$(command -v sing-box)
  if [ -s "$_sj" ] && [ "$_sj" -nt /usr/bin/podkop ] && [ "$_sj" -nt "$0" ] &&
     { [ -z "$_sb" ] || [ "$_sj" -nt "$_sb" ]; } && { [ ! -x "$PROBE" ] || [ "$_sj" -nt "$PROBE" ]; }; then
    cat "$_sj"; return
  fi
  _sv=$(sing-box version 2>/dev/null)
  jq -nc --arg model "$(cat /tmp/sysinfo/model 2>/dev/null)" \
    --arg os "$(sed -n "s/^DISTRIB_DESCRIPTION='\(.*\)'/\1/p" /etc/openwrt_release 2>/dev/null)" \
    --arg pk "$(podkop show_version 2>/dev/null)" \
    --arg sb "$(printf '%s\n' "$_sv" | awk 'NR == 1 { print $3 }')" \
    --arg feat "$(printf '%s\n' "$_sv" | sed -n 's/^Features:[[:space:]]*//p')" \
    --arg eng "$(printf '%s\n' "$_sv" | grep -q 'tools.decode-link' && echo 1)" \
    --arg pb "$([ -x "$PROBE" ] && sed -n 's/^VERSION="\(.*\)"/\1/p' "$PROBE")" \
    '{model: $model, os: $os, podkop: $pk, singbox: $sb, features: ($feat | split(",") | map(select(. != ""))),
      engine: ($eng == "1"), probe: $pb}' > "$_sj.t" && mv "$_sj.t" "$_sj"
  cat "$_sj"
}

# fatal_since <marker>: podkop's first fatal message after our marker log line
fatal_since() {
  logread 2>/dev/null | sed -n "/podkop-agent: $1\$/,\$p" | grep '\[fatal\]' | head -n 1 |
    sed 's/.*\[fatal\] //; s/ Aborted\.$//'
}

dns_ok() {
  for _h in openwrt.org ya.ru; do
    nslookup "$_h" 127.0.0.1 2>/dev/null |
      awk '/^Name:/ { n = 1; next } n && /^Address/ { f = 1 } END { exit !f }' && return 0
  done
  return 1
}

# health <marker>: after a restart, wait until podkop runs every section's
# outbound and DNS answers; on failure the reason goes to stdout
health() {
  _w=0
  while :; do
    _st=$(podkop_start_state)
    case "$_st" in
      running|none) ;;
      0) break ;;
      *) _m=$(fatal_since "$1"); echo "podkop did not start${_m:+: $_m}"; return 1 ;;
    esac
    [ "$_w" -ge 90 ] && { echo "podkop start did not finish in 90 s"; return 1; }
    sleep 2; _w=$((_w + 2))
  done
  _tags=$(config_json | jq -r '.sections[] | select(.type == "section"
            and (.options.connection_type | IN("proxy", "vpn"))) | .name + "-out"')
  _w=0
  while :; do
    _p=$(proxies)
    _miss=""
    for _t in $_tags; do
      printf '%s' "$_p" | jq -e --arg t "$_t" '.proxies[$t]' >/dev/null 2>&1 || _miss="$_miss $_t"
    done
    [ -n "$_p" ] && [ -z "$_miss" ] && break
    case "$(podkop_start_state)" in
      running|none|0) ;;
      *) _m=$(fatal_since "$1"); echo "podkop did not start${_m:+: $_m}"; return 1 ;;
    esac
    if [ "$_w" -ge 30 ]; then
      if [ -z "$(singbox_pid)" ]; then echo "sing-box is not running"; else echo "sing-box has no outbound${_miss}"; fi
      return 1
    fi
    sleep 2; _w=$((_w + 2))
  done
  _w=0
  until dns_ok; do
    [ "$_w" -ge 20 ] && { echo "DNS through the router does not answer"; return 1; }
    sleep 2; _w=$((_w + 2))
  done
  return 0
}

# restart_podkop <marker>
restart_podkop() {
  logger -t podkop-agent "$1"
  # strict sections: their domains answer NXDOMAIN while podkop is away
  # (podkop's stop restarts dnsmasq, which then reads the file)
  if command -v guard_dns_on >/dev/null 2>&1 && guard_wanted; then guard_build; guard_dns_on norestart; fi
  # 9>&-: podkop must not inherit (and keep holding) the apply lock
  /etc/init.d/podkop restart >/dev/null 2>&1 9>&-
}

# --- only servers changed: no podkop restart -----------------------------------

# A full restart stops sing-box, removes the firewall rules and DNS setup,
# rebuilds everything and loads the IP lists again: 20-30 s without proxy.
# When only the servers of rules changed, nothing but sing-box's config
# depends on that: podkop's own functions build its new config, and
# sing-box reloads it in place (SIGHUP), a fraction of a second.

# the options that only say which servers a rule uses
SERVER_OPTS='["urltest_proxy_links","urltest_fallback_links","selector_proxy_links","proxy_string"]'
# ... and the ones that change nothing but sing-box's config either: a rule's
# own domains (its local rule-set file, in RAM), its URLTest settings, a VPN
# rule's interface and DNS server. Subnets, community and local or remote
# list files feed podkop's nft sets, so they still need podkop's start. A
# rule added or removed is taken the same way when it matches by its own
# domains only (no lists, subnets, devices or local proxy port).
SINGBOX_OPTS='["urltest_proxy_links","urltest_fallback_links","selector_proxy_links","proxy_string",
  "user_domain_list_type","user_domains","user_domains_text",
  "urltest_testing_url","urltest_check_interval","urltest_tolerance","outbound_json",
  "interface","domain_resolver_enabled","domain_resolver_dns_type","domain_resolver_dns_server"]'

# options_only <options json> <old config> <new config> [light] (JSON files):
# they differ only in those; with "light", also in domain-only rules that
# are in one of them only
options_only() {
  jq -n --slurpfile a "$2" --slurpfile b "$3" --argjson o "$1" --arg light "${4:-}" '
    def n: if type == "array" then length elif . == null or . == "" then 0 else 1 end;
    def light: .type == "section" and ((.options.connection_type // "") | IN("proxy", "vpn"))
      and ((.options.user_subnet_list_type // "disabled") == "disabled") and ((.options.mixed_proxy_enabled // "0") != "1")
      and ([.options | .community_lists, .local_domain_lists, .local_subnet_lists, .remote_domain_lists,
            .remote_subnet_lists, .fully_routed_ips | n] | add) == 0;
    def strip($other): ((.sections[] | select(.name == "settings") | .options) |= del(.shutdown_correctly))
      | [$other.sections[].name] as $names
      | .sections |= map(select($light == "" or (light | not) or (.name as $x | $names | index($x))))
      | .sections |= map(.options |= with_entries(select(.key | IN($o[]) | not)));
    ($a[0] | strip($b[0])) == ($b[0] | strip($a[0]))' 2>/dev/null | grep -qx true
}
servers_only() { options_only "$SERVER_OPTS" "$1" "$2"; }
singbox_only() { options_only "$SINGBOX_OPTS" "$1" "$2" light; }

# domain_sections <old config> <new config>: the sections whose own domain
# list changed (or that are new); podkop fills a rule-set file only when it
# is missing, so theirs are removed before the build and made anew
domain_sections() {
  jq -nr --slurpfile a "$1" --slurpfile b "$2" '
    def d: [.sections[] | select(.type == "section")
            | {key: .name, value: [.options.user_domain_list_type, .options.user_domains, .options.user_domains_text]}] | from_entries;
    ($a[0] | d) as $x | ($b[0] | d) as $y | $y | to_entries[] | select($x[.key] != .value) | .key' 2>/dev/null
}
rulesets_dir() ( set +u; . "$PODKOP_LIB/constants.sh" 2>/dev/null; printf '%s' "${TMP_RULESET_FOLDER:-/tmp/sing-box/rulesets}" )

# podkop_build <file>: the sing-box config podkop makes from its settings now,
# by its own functions (its start runs the same sing_box_init_config, which
# only builds JSON); only the last step, saving it, writes to <file> instead
podkop_build() (
  set +u
  _out=$1
  for _f in /lib/functions.sh /lib/config/uci.sh /lib/functions/network.sh; do . "$_f" || exit 1; done
  for _f in constants nft helpers sing_box_config_manager sing_box_config_facade logging rulesets; do
    . "$PODKOP_LIB/$_f.sh" || exit 1
  done
  # podkop's functions, without running podkop (outside them it only loads
  # these files and runs the command it is given)
  eval "$(sed -n '/^[A-Za-z_][A-Za-z0-9_]*() {$/,/^}$/p' /usr/bin/podkop)" || exit 1
  # shellcheck disable=SC2329   # called by podkop's functions
  log() { case "${2:-}" in error|fatal) printf '%s\n' "$1" >> "$_out.err" ;; esac; }
  # a start finds the rule-set folder empty (its stop empties it), so each
  # local rule set is added as new; here its file is already there, with the
  # same content (podkop merges the same, unchanged lists into it again)
  # shellcheck disable=SC2329
  create_source_rule_set() { [ -f "$1" ] || jq -n '{version: 3, rules: []}' > "$1"; }
  # $config: podkop's sing_box_init_config builds it
  # shellcheck disable=SC2154,SC2329
  sing_box_save_config() { sing_box_cm_save_config_to_file "$config" "$_out" && sing-box check -c "$_out" >/dev/null 2>&1; }
  config_load podkop
  sing_box_init_config
)

# hot_apply <marker>: podkop runs; its new sing-box config goes in and
# sing-box reloads it; fails (and the caller restarts podkop) when anything
# is off. On failure the reason goes to stdout.
hot_apply() {
  _hp=$(singbox_pid)
  if [ -z "$_hp" ] || [ "$(podkop_start_state)" != 0 ]; then echo "podkop is not fully running"; return 1; fi
  _cp=$(uci -q get podkop.settings.config_path)
  if [ -z "$_cp" ] || [ ! -f "$_cp" ]; then echo "no sing-box config file"; return 1; fi
  _hb="$RUN/hot.$$.json"
  rm -f "$_hb" "$_hb.err"
  if ! podkop_build "$_hb" || [ -s "$_hb.err" ] || ! jq -e '.outbounds' "$_hb" >/dev/null 2>&1; then
    echo "podkop could not build the config: $(head -n 1 "$_hb.err" 2>/dev/null)"; rm -f "$_hb" "$_hb.err"; return 1
  fi
  cp "$_hb" "$_hb.base"            # podkop's own build, for protect_ok
  if command -v heal_filter >/dev/null 2>&1; then
    if ! { heal_filter "$_hb" "$_hb.s" && mv "$_hb.s" "$_hb"; }; then
      rm -f "$_hb" "$_hb.s" "$_hb.base" "$_hb.err"; echo "invalid self-heal state"; return 1
    fi
  fi
  if ! { jq "$HEALTH_JQ" "$_hb" > "$_hb.i" && mv "$_hb.i" "$_hb"; }; then
    rm -f "$_hb" "$_hb.i" "$_hb.base" "$_hb.err"; echo "could not add gRPC pings and connection preservation"; return 1
  fi
  if [ -s "$VPN_DIR/allow" ]; then
    if ! { vpn_filter "$_hb" "$_hb.v" && mv "$_hb.v" "$_hb" && sing-box check -c "$_hb" >/dev/null 2>&1; }; then
      rm -f "$_hb" "$_hb.v" "$_hb.base" "$_hb.err"; echo "invalid devices of VPN rules"; return 1
    fi
  fi
  if command -v reliability_filter >/dev/null 2>&1; then
    if ! { reliability_filter "$_hb" "$_hb.r" && mv "$_hb.r" "$_hb"; }; then
      rm -f "$_hb" "$_hb.r" "$_hb.base"; echo "invalid eligibility policy"; return 1
    fi
    sing-box check -c "$_hb" >/dev/null 2>&1 || { rm -f "$_hb" "$_hb.base"; echo "invalid filtered config"; return 1; }
  fi
  # last: the filters above find each rule's route rules by "<rule>-out"
  if ! { zapret_filter "$_hb" "$_hb.z" && mv "$_hb.z" "$_hb" && sing-box check -c "$_hb" >/dev/null 2>&1; }; then
    rm -f "$_hb" "$_hb.z" "$_hb.base" "$_hb.err"; echo "invalid zapret rules"; return 1
  fi
  if ! protect_ok "$_hb.base" "$_hb"; then rm -f "$_hb" "$_hb.base" "$_hb.err"; echo "the change would alter a protected rule"; return 1; fi
  rm -f "$_hb.base"
  logger -t podkop-agent "$1"
  if ! cmp -s "$_hb" "$_cp"; then
    if ! { cp "$_hb" "$_cp.agent-new" && mv "$_cp.agent-new" "$_cp"; }; then
      rm -f "$_hb" "$_cp.agent-new"; echo "could not write $_cp"; return 1
    fi
  fi
  _tags=$(jq -r '.outbounds[].tag' "$_hb")
  rm -f "$_hb" "$_hb.err"
  kill -HUP "$_hp" 2>/dev/null || { echo "sing-box did not take the signal"; return 1; }
  # the same sing-box, with every outbound of the new config
  _w=0
  while :; do
    sleep 1; _w=$((_w + 1))
    [ "$(singbox_pid)" = "$_hp" ] || { echo "sing-box stopped while reloading"; return 1; }
    _p=$(proxies); _miss=""
    for _t in $_tags; do
      case "$_t" in direct-out|*-urltest-out) continue ;; esac
      printf '%s' "$_p" | jq -e --arg t "$_t" '.proxies[$t]' >/dev/null 2>&1 || _miss="$_miss $_t"
    done
    [ -n "$_p" ] && [ -z "$_miss" ] && break
    [ "$_w" -ge 15 ] && { echo "sing-box did not take the new servers:${_miss:- no Clash API}"; return 1; }
  done
  # a reload puts every selector back on its default member: kill switches
  # that were closed are closed again now, not at the next self-heal round
  if command -v strict_enforce >/dev/null 2>&1 && [ -s "$ETC/strict" ]; then
    mkdir -p "$RUN/heal"; printf '%s' "$_p" > "$RUN/heal/proxies.json"; strict_enforce "$RUN/heal/proxies.json" "$_cp"
  fi
  dns_ok || { sleep 2; dns_ok; } || { echo "DNS through the router does not answer"; return 1; }
}

# --- dead servers: connections don't hang ------------------------------------------

# Two sing-box options podkop leaves off; podkop writes its config without
# them at every start, the daemon adds them then, hot_apply at once:
# - gRPC: when a server stops answering, its connections just wait for data
#   that never comes, and apps (phones above all) hang for minutes until their
#   own timeouts. With HTTP/2 pings (idle_timeout, ping_timeout) a quiet
#   connection is pinged after 15 s and dropped 15 s later without an answer,
#   with everything on it: apps reconnect at once. A link's own values stay.
# - URLTest: preserve established connections on a latency-driven switch.
#   gRPC pings still detect dead transports; changing exits must not abort
#   healthy uploads, signups and streams.
HEALTH_JQ='(.outbounds[]? | select(.type == "urltest")) += {interrupt_exist_connections: false}
  | (.outbounds[]? | select(.transport.type == "grpc") | .transport) |= ({idle_timeout: "15s", ping_timeout: "15s"} + .)'

# health_on: sing-box's config gets them and sing-box reloads in place
# ("reloaded" on stdout); nothing is written when they're there already, and
# a config sing-box would refuse with them stays as it is (tried once per sing-box)
health_on() {
  _ic=$(uci -q get podkop.settings.config_path)
  _ip=$(singbox_pid)
  if [ -z "$_ic" ] || [ ! -f "$_ic" ] || [ -z "$_ip" ]; then return 0; fi
  [ "$(cat "$RUN/health.failed" 2>/dev/null)" = "$_ip" ] && return 0
  if command -v heal_filter >/dev/null 2>&1; then
    heal_filter "$_ic" "$RUN/health.in" 2>/dev/null || cp "$_ic" "$RUN/health.in"
  else cp "$_ic" "$RUN/health.in"; fi
  jq "$HEALTH_JQ" "$RUN/health.in" > "$RUN/health.json" 2>/dev/null || { rm -f "$RUN/health.json" "$RUN/health.in"; return 0; }
  rm -f "$RUN/health.in"
  if ! { vpn_filter "$RUN/health.json" "$RUN/health.vpn" && mv "$RUN/health.vpn" "$RUN/health.json"; }; then
    rm -f "$RUN/health.json" "$RUN/health.vpn"; return 0
  fi
  if command -v reliability_filter >/dev/null 2>&1; then
    reliability_filter "$RUN/health.json" "$RUN/health.filtered" && mv "$RUN/health.filtered" "$RUN/health.json" || return 0
  fi
  if ! { zapret_filter "$RUN/health.json" "$RUN/health.z" && mv "$RUN/health.z" "$RUN/health.json"; }; then
    rm -f "$RUN/health.json" "$RUN/health.z"; return 0
  fi
  if [ "$(jq -c . "$RUN/health.json")" = "$(jq -c . "$_ic")" ]; then rm -f "$RUN/health.json"; return 0; fi
  if ! { protect_ok "$_ic" "$RUN/health.json" && sing-box check -c "$RUN/health.json" >/dev/null 2>&1 &&
         cp "$RUN/health.json" "$_ic.agent-new" && mv "$_ic.agent-new" "$_ic"; }; then
    rm -f "$RUN/health.json" "$_ic.agent-new"; echo "$_ip" > "$RUN/health.failed"
    logger -t podkop-agent "could not add gRPC pings and connection preservation to sing-box's config"
    return 0
  fi
  rm -f "$RUN/health.json"
  logger -t podkop-agent "dead servers: gRPC pings and connection preservation added to sing-box's config"
  if kill -HUP "$_ip" 2>/dev/null; then echo reloaded; fi
}

# through temp files, so a full disk can't leave a cut-off copy
save_last_good() {
  cp "$CFG" "$ETC/last-good.t" && mv "$ETC/last-good.t" "$ETC/last-good" &&
    config_fp > "$ETC/last-good.fp.t" && mv "$ETC/last-good.fp.t" "$ETC/last-good.fp"
}

backup_config() {
  mkdir -p "$ETC/backups"
  _b="$ETC/backups/podkop.$(date +%Y%m%d-%H%M%S)"
  cp "$CFG" "$_b" || return 1
  ls -1t "$ETC/backups"/podkop.* 2>/dev/null | tail -n +11 | while IFS= read -r _f; do rm -f "$_f"; done
  echo "$_b"
}

# install_config <file>: replace podkop's settings in one rename
install_config() { cp "$1" "$CFG.agent-new" && mv "$CFG.agent-new" "$CFG"; }

# --- pinned servers ---------------------------------------------------------------

# pins file: "<section><TAB><md5 of the link>"; the tag of a link is its position
# in the section, so after a change the pin follows the link, not the position
link_md5() { printf '%s' "$1" | md5sum | cut -c 1-32; }

# tag_link <section> <tag> -> the link behind an outbound tag of the section
tag_link() {
  config_json | jq -r --arg s "$1" --arg t "$2" '
    def lst: if . == null then [] elif type == "array" then . else [.] end;
    .sections[] | select(.name == $s) | .options as $o
    | (if $o.proxy_config_type == "urltest" then
         [($o.urltest_proxy_links | lst | to_entries[] | {t: "\($s)-\(.key + 1)-out", l: .value}),
          ($o.urltest_fallback_links | lst | to_entries[] | {t: "\($s)-fallback-\(.key + 1)-out", l: .value})]
       elif $o.proxy_config_type == "selector" then
         [$o.selector_proxy_links | lst | to_entries[] | {t: "\($s)-\(.key + 1)-out", l: .value}]
       else [] end)[] | select(.t == $t) | .l' | head -n 1
}

# link_tag <section> <md5> -> the current tag of that link
link_tag() {
  config_json | jq -r --arg s "$1" '
    def lst: if . == null then [] elif type == "array" then . else [.] end;
    .sections[] | select(.name == $s) | .options as $o
    | if $o.proxy_config_type == "urltest" then
        ($o.urltest_proxy_links | lst | to_entries[] | "\($s)-\(.key + 1)-out\t\(.value)"),
        ($o.urltest_fallback_links | lst | to_entries[] | "\($s)-fallback-\(.key + 1)-out\t\(.value)")
      elif $o.proxy_config_type == "selector" then
        ($o.selector_proxy_links | lst | to_entries[] | "\($s)-\(.key + 1)-out\t\(.value)")
      else empty end' |
  while IFS="$TAB" read -r _t _l; do
    [ "$(link_md5 "$_l")" = "$2" ] && { echo "$_t"; return; }
  done
}

select_server() { podkop clash_api set_group_proxy "$1-out" "$2" 2>/dev/null | jq -e '.success' >/dev/null 2>&1; }

# reapply_pins: after a restart podkop's selectors start on their default
# fails when a pinned server could not be selected (Clash API not up yet)
reapply_pins() {
  [ -s "$ETC/pins" ] || return 0
  mkdir -p "$RUN"
  exec 6> "$RUN/pins.lock"; flock 6
  : > "$RUN/pins.new"; _rp=0
  while IFS="$TAB" read -r _s _h; do
    _t=$(link_tag "$_s" "$_h")
    if [ -z "$_t" ]; then
      event pin_dropped "$(jq -nc --arg s "$_s" '{section: $s, reason: "the pinned server is no longer in the section"}')"
      continue
    fi
    printf '%s\t%s\n' "$_s" "$_h" >> "$RUN/pins.new"
    if select_server "$_s" "$_t"; then
      event pin_restored "$(jq -nc --arg s "$_s" --arg t "$_t" '{section: $s, server: $t}')"
    else
      _rp=1
    fi
  done < "$ETC/pins"
  # /etc is flash: written only when a pin was dropped
  if cmp -s "$RUN/pins.new" "$ETC/pins"; then rm -f "$RUN/pins.new"
  else cp "$RUN/pins.new" "$ETC/pins.t" && mv "$ETC/pins.t" "$ETC/pins"; rm -f "$RUN/pins.new"; fi
  exec 6>&-
  return "$_rp"
}

# --- jobs (changes run detached, so a dropped SSH connection can't cut them) -------

job_file() { echo "$RUN/jobs/$1.json"; }

# job_set <id> <jq filter> [jq args ...]
job_set() {
  _jf=$(job_file "$1"); _flt=$2; shift 2
  jq -c "$@" "$_flt" "$_jf" > "$_jf.t" && mv "$_jf.t" "$_jf"
}

job_new() { # <kind> -> id
  mkdir -p "$RUN/jobs"
  _id="$(date +%Y%m%d%H%M%S)-$$"
  jq -nc --arg id "$_id" --arg k "$1" --arg t "$(now)" '{id: $id, kind: $k, state: "queued", started: $t}' > "$(job_file "$_id")"
  ls -1t "$RUN/jobs"/*.json 2>/dev/null | tail -n +21 | while IFS= read -r _f; do rm -f "$_f" "${_f%.json}".*; done
  echo "$_id"
}

# job_end <id> <state> <message> [fields json]
job_end() {
  _ex=${4:-}; [ -n "$_ex" ] || _ex='{}'
  job_set "$1" '. + {state: $s, message: $m, finished: $t} + $x' --arg s "$2" --arg m "$3" --arg t "$(now)" --argjson x "$_ex"
}

spawn() { env -u SSH_ORIGINAL_COMMAND -u SSH_CONNECTION -u SSH_CLIENT setsid "$0" "$@" </dev/null >/dev/null 2>&1 & }

# the apply transaction; input in jobs/<id>.in: {"base": fingerprint, "config": {...}}
run_apply() {
  _id=$1; _in="$RUN/jobs/$_id.in"; _new="$RUN/jobs/$_id.conf"
  exec 9> "$RUN/apply.lock"; flock 9
  job_set "$_id" '.state = "checking"'
  jq -c ".config | $NORM" "$_in" > "$_new" 2>/dev/null || { job_end "$_id" rejected "the config is not valid JSON"; return; }
  _cur=$(config_fp) || { job_end "$_id" failed "could not read podkop's settings (ubus does not answer)"; return; }
  _base=$(jq -r '.base // ""' "$_in")
  if [ -n "$_base" ] && [ "$_base" != "$_cur" ]; then
    job_end "$_id" rejected "podkop's settings changed since you loaded them; reload and apply again" \
      "$(jq -nc --arg c "$_cur" '{code: "config_changed", fingerprint: $c}')"
    return
  fi
  _bad=$(check_names "$_new")
  [ -z "$_bad" ] || { job_end "$_id" rejected "\"$_bad\" is not a valid name"; return; }
  _probs=$(validate "$_new")
  if [ "$_probs" != "[]" ]; then
    job_end "$_id" rejected "podkop would not start with these settings" "$(jq -nc --argjson p "$_probs" '{problems: $p}')"
    return
  fi
  _nfp=$(fingerprint < "$_new")
  if [ "$_nfp" = "$_cur" ]; then job_end "$_id" unchanged "nothing to change"; return; fi
  config_json > "$RUN/jobs/$_id.old" || { job_end "$_id" failed "could not read podkop's settings (ubus does not answer)"; return; }
  mkdir -p "$RUN/stage"
  jq -r "$TOUCI" "$_new" > "$RUN/stage/podkop"
  uci -c "$RUN/stage" -q show podkop >/dev/null 2>&1 || { job_end "$_id" rejected "could not write the settings file"; return; }
  _bak=$(backup_config) || { job_end "$_id" failed "could not back up $CFG"; return; }
  # survives a reboot: the daemon puts the backup back if this apply never ends
  printf '%s\t%s\n' "$_id" "$_bak" > "$ETC/apply-pending" || { job_end "$_id" failed "could not write $ETC/apply-pending"; return; }
  install_config "$RUN/stage/podkop" || { rm -f "$ETC/apply-pending"; job_end "$_id" failed "could not write $CFG"; return; }
  _x=$(jq -nc --arg b "$_cur" --arg a "$_nfp" --arg k "$_bak" '{fingerprint_before: $b, fingerprint_after: $a, backup: $k}')
  if [ -f "$ETC/paused" ] || ! podkop_enabled; then
    rm -f "$ETC/apply-pending"
    job_end "$_id" saved "saved; podkop is stopped, so it was not restarted" "$_x"
    event applied "$(jq -nc --arg j "$_id" '{job: $j, restarted: false}')"
    return
  fi
  # only servers, or only servers and domain lists, changed: sing-box takes
  # them without a podkop restart
  _hk=""
  if servers_only "$RUN/jobs/$_id.old" "$_new"; then _hk="only servers changed"
  elif singbox_only "$RUN/jobs/$_id.old" "$_new"; then _hk="only servers, domain lists and domain-only rules changed"; fi
  if [ -n "$_hk" ]; then
    job_set "$_id" '.state = "reloading"'
    _rd=$(rulesets_dir); rm -rf "$RUN/rulesets.bak"; mkdir -p "$RUN/rulesets.bak"
    for _ds in $(domain_sections "$RUN/jobs/$_id.old" "$_new"); do
      [ -f "$_rd/$_ds-user-domains-ruleset.json" ] && mv "$_rd/$_ds-user-domains-ruleset.json" "$RUN/rulesets.bak/"
    done
    if _hw=$(hot_apply "apply $_id ($_hk)"); then
      rm -rf "$RUN/rulesets.bak"
      save_last_good; rm -f "$ETC/apply-pending"; reapply_pins
      job_end "$_id" applied "applied without restarting podkop ($_hk)" "$(printf '%s' "$_x" | jq -c '. + {hot: true}')"
      event applied "$(jq -nc --arg j "$_id" '{job: $j, restarted: true, hot: true}')"
      return
    fi
    # sing-box still runs the old config: its rule-set files go back
    for _f in "$RUN/rulesets.bak"/*; do [ -f "$_f" ] && mv "$_f" "$_rd/"; done
    rm -rf "$RUN/rulesets.bak"
    logger -t podkop-agent "apply $_id: no reload in place ($_hw), restarting podkop"
  fi
  job_set "$_id" '.state = "restarting"'
  restart_podkop "apply $_id"
  if _why=$(health "apply $_id"); then
    save_last_good; rm -f "$ETC/apply-pending"; reapply_pins
    job_end "$_id" applied "applied, podkop is running" "$_x"
    event applied "$(jq -nc --arg j "$_id" '{job: $j, restarted: true}')"
    return
  fi
  job_set "$_id" '.state = "reverting"'
  if ! install_config "$_bak"; then
    rm -f "$ETC/apply-pending"
    job_end "$_id" failed "$_why; the old settings could not be restored (could not write $CFG from $_bak)" "$_x"
    event revert_failed "$(jq -nc --arg j "$_id" --arg r "$_why" --arg r2 "could not write $CFG from $_bak" '{job: $j, reason: $r, revert_reason: $r2}')"
    return
  fi
  restart_podkop "revert $_id"
  if _why2=$(health "revert $_id"); then
    reapply_pins
    job_end "$_id" reverted "$_why; the old settings are back" "$(printf '%s' "$_x" | jq -c --arg r "$_why" '. + {reason: $r}')"
    event reverted "$(jq -nc --arg j "$_id" --arg r "$_why" '{job: $j, reason: $r}')"
  else
    job_end "$_id" failed "$_why; the old settings are back, but podkop does not run with them either: $_why2" "$_x"
    event revert_failed "$(jq -nc --arg j "$_id" --arg r "$_why" --arg r2 "$_why2" '{job: $j, reason: $r, revert_reason: $r2}')"
  fi
  rm -f "$ETC/apply-pending"
}

# undo_interrupted: an apply cut off by a reboot or a kill left
# $ETC/apply-pending ("<job><TAB><backup>"); put the backup back
undo_interrupted() {
  [ -s "$ETC/apply-pending" ] || return 0
  exec 9> "$RUN/apply.lock"
  flock -n 9 || { exec 9>&-; return 0; }   # that apply is still running
  IFS="$TAB" read -r _id _bak < "$ETC/apply-pending"
  if [ -f "$_bak" ] && install_config "$_bak"; then
    _st=reverted; _m="the apply was interrupted (reboot or killed); the old settings were put back"
    [ -f "$ETC/paused" ] || ! podkop_enabled || restart_podkop "undo interrupted apply $_id"
  else
    _st=failed; _m="the apply was interrupted (reboot or killed); the old settings could not be put back from $_bak"
  fi
  rm -f "$ETC/apply-pending"
  if [ -f "$(job_file "$_id")" ]; then
    case "$(jq -r .state "$(job_file "$_id")" 2>/dev/null)" in
      queued|checking|restarting|reloading|reverting) job_end "$_id" "$_st" "$_m" ;;
    esac
  fi
  event apply_interrupted "$(jq -nc --arg j "$_id" --arg b "$_bak" --arg m "$_m" '{job: $j, backup: $b, message: $m}')"
  exec 9>&-
}

# --- safe mode and protected rules ---------------------------------------------------
#
# Safe mode ($ETC/safe-mode: "<time><TAB><reason>"): the router runs plain
# podkop. The daemon idles, and nothing here restarts podkop, reloads
# sing-box or changes its config; reading, logs, an agent update and podkop's
# own start and stop still work. podkop-sentinel (a script of its own, see
# install.sh) switches it on when a protected rule stops working and plain
# podkop makes it work again; "safe-mode on|off" does it by hand.
#
# Protected rules ($ETC/protected, one section per line): the agent never
# changes how they work at run time. They are not healed (no borrowed
# servers), none of their servers is kept out of its group, and a sing-box
# config in which their outbounds or their routing differ from what podkop
# built is not written (protect_ok), whatever asked for it.
safe_mode() { [ -f "$ETC/safe-mode" ]; }
safe_json() {
  if safe_mode; then
    IFS="$TAB" read -r _sm_t _sm_r < "$ETC/safe-mode"
    jq -nc --arg t "$_sm_t" --arg r "$_sm_r" --arg trial "$([ -f /tmp/podkop-sentinel/trial ] && echo 1)" \
      '{on: true, since: ($t | tonumber? // null), reason: $r, trial: ($trial == "1")}'
  else echo '{"on":false}'; fi
}
sentinel_json() {
  jq -nc --arg v "$([ -x /usr/bin/podkop-sentinel ] && /usr/bin/podkop-sentinel version 2>/dev/null)" \
    --arg run "$(ubus call service list '{"name":"podkop-sentinel"}' 2>/dev/null | jq -r '[.["podkop-sentinel"].instances[]? | select(.running)] | length')" \
    '{version: ($v | tonumber? // null), running: (($run | tonumber? // 0) > 0)}'
}
protected_json() {
  if [ -s "$ETC/protected" ]; then jq -Rsc 'split("\n") | map(select(. != ""))' "$ETC/protected"; else echo '[]'; fi
}

# protect_ok <podkop's build> <the config to write>: for every protected
# section the outbounds named after it and the route rules that send to it
# are the same in both (but for the two options of "dead servers" below),
# and so are the final route and DNS. A kill switch's refusing member and a
# VPN rule's device list are additions of ours that leave the rule as it is.
PROTECT_JQ='
def norm: del(.interrupt_exist_connections)
  | if (.transport.type? // "") == "grpc" then .transport |= del(.idle_timeout, .ping_timeout) else . end
  | if .type == "selector" then .outbounds |= map(select(endswith("-strict-out") | not)) else . end;
def view($c): {
  outbounds: [$c.outbounds[]? | select(.tag as $t | ($t | endswith("-strict-out") | not)
                 and any($prot[]; . as $s | $t | startswith($s + "-"))) | norm] | sort_by(.tag),
  rules: [$c.route.rules[]? | select((.outbound // "") as $o | any($prot[]; . + "-out" == $o)) | del(.source_ip_cidr)],
  final: ($c.route.final // null), dns: ($c.dns // null)};
view($a[0]) == view($b[0])'
protect_ok() {
  [ -s "$ETC/protected" ] || return 0
  jq -ne --slurpfile a "$1" --slurpfile b "$2" --argjson prot "$(protected_json)" "$PROTECT_JQ" >/dev/null 2>&1 && return 0
  logger -t podkop-agent "protected rules: a config that changes them was not written"
  event protect_refused "$(jq -nc --argjson p "$(protected_json)" '{sections: $p}')"
  return 1
}

# safe-mode [on|off]: -> {on, since, reason, trial}
cmd_safe_mode() {
  case "${1:-}" in
    "") ;;
    on)
      [ -x /usr/bin/podkop-sentinel ] || fail unsupported "podkop-sentinel is not installed (update the agent)"
      safe_mode || { flock -n "$RUN/apply.lock" true || fail busy "an apply or a recovery is running"
        env -u SSH_ORIGINAL_COMMAND -u SSH_CONNECTION -u SSH_CLIENT setsid /usr/bin/podkop-sentinel enter "switched on in podkop-manager" </dev/null >/dev/null 2>&1 &
        _i=0; while ! safe_mode && [ "$_i" -lt 10 ]; do sleep 1; _i=$((_i + 1)); done; } ;;
    off)
      if safe_mode; then
        [ -x /usr/bin/podkop-sentinel ] || fail unsupported "podkop-sentinel is not installed (update the agent)"
        env -u SSH_ORIGINAL_COMMAND -u SSH_CONNECTION -u SSH_CLIENT setsid /usr/bin/podkop-sentinel leave "switched off in podkop-manager" </dev/null >/dev/null 2>&1 &
        _i=0; while safe_mode && [ "$_i" -lt 10 ]; do sleep 1; _i=$((_i + 1)); done
      fi ;;
    *) fail bad_request "usage: safe-mode [on|off]" ;;
  esac
  reply "$(safe_json)"
}

# protect: stdin {"sections": [names]} -> {protected: [...]}; sing-box reloads
# in place when the set changes (borrowed servers leave a rule protected now)
cmd_protect() {
  _pr=$(head -c 65536)
  printf '%s' "$_pr" | jq -e '(.sections | type == "array" and length <= 100)
    and all(.sections[]; type == "string" and length > 0 and (explode | all(. == 95
      or (. >= 48 and . <= 57) or (. >= 65 and . <= 90) or (. >= 97 and . <= 122))))' >/dev/null 2>&1 ||
    fail bad_request 'expected {"sections": [section names]}'
  # the lock first: a list written and then "busy" would be a change half made
  _plock=0
  if [ -n "$(singbox_pid)" ] && ! safe_mode; then
    exec 9> "$RUN/apply.lock"; flock -n 9 || fail busy "an apply is in progress; try again in a moment"
    _plock=1
  fi
  printf '%s' "$_pr" | jq -r '.sections | unique | .[]' > "$RUN/protected.t"
  _changed=1
  if [ -s "$RUN/protected.t" ]; then
    if cmp -s "$RUN/protected.t" "$ETC/protected" 2>/dev/null; then _changed=0
    else { cp "$RUN/protected.t" "$ETC/protected.t" && mv "$ETC/protected.t" "$ETC/protected"; } ||
      { rm -f "$RUN/protected.t"; fail error "could not write $ETC/protected"; }; fi
  else
    [ -f "$ETC/protected" ] || _changed=0
    rm -f "$ETC/protected"
  fi
  rm -f "$RUN/protected.t"
  if [ "$_changed" = 1 ]; then
    event protected "$(jq -nc --argjson s "$(protected_json)" '{sections: $s}')"
    if [ "$_plock" = 1 ]; then
      _pw=$(hot_apply "protected rules changed") || { exec 9>&-; fail recovery_failed "sing-box did not take the change: $_pw"; }
    fi
  fi
  [ "$_plock" = 0 ] || exec 9>&-
  reply "$(jq -nc --argjson p "$(protected_json)" '{protected: $p}')"
}

# --- watchdog -------------------------------------------------------------------

# recover: podkop is enabled but sing-box is gone (failsafe, crash, reboot);
# at most 3 tries an hour, so it can't fight a crash loop
recover() {
  _t=$(date +%s)
  awk -v t="$_t" '$1 > t - 3600' "$RUN/recoveries" 2>/dev/null > "$RUN/recoveries.t"
  mv "$RUN/recoveries.t" "$RUN/recoveries"
  if [ "$(wc -l < "$RUN/recoveries")" -ge 3 ]; then
    [ -f "$RUN/gave-up" ] || { touch "$RUN/gave-up"; event recovery_gave_up '{"reason":"3 recoveries in the last hour"}'; }
    return
  fi
  echo "$_t" >> "$RUN/recoveries"
  exec 9> "$RUN/apply.lock"; flock 9
  # first with the settings as they are (LuCI or the probe may have changed
  # them on purpose); the last settings applied here only if that fails
  _what="restarted podkop"
  restart_podkop "recover $_t"
  # (not with the provider's line down: no settings pass the check then, and
  # the last-good ones may be older than what the probe or LuCI set since)
  if ! _why=$(health "recover $_t") && [ -s "$ETC/last-good" ] && _fp=$(config_fp) &&
     [ "$_fp" != "$(cat "$ETC/last-good.fp" 2>/dev/null)" ] &&
     { ! command -v heal_wan >/dev/null 2>&1 || heal_wan; } &&
     _bk=$(backup_config) && install_config "$ETC/last-good"; then
    restart_podkop "recover $_t last-good"
    if _why=$(health "recover $_t last-good"); then
      _what="podkop did not start with its settings; restored the last working settings and restarted podkop"; _why=""
    else
      # they do not work either: the settings there were go back
      install_config "$_bk" && restart_podkop "recover $_t: settings back"
      _what="podkop started neither with its settings nor with the last working ones; its settings are back in place"
    fi
  fi
  if [ -z "$_why" ]; then
    rm -f "$RUN/gave-up"; reapply_pins
    event recovered "$(jq -nc --arg w "$_what" '{action: $w}')"
  else
    event recovery_failed "$(jq -nc --arg w "$_what" --arg r "$_why" '{action: $w, reason: $r}')"
  fi
  exec 9>&-
}

# --- traffic per server ------------------------------------------------------------

# traffic_poll: add each connection's new bytes to its server (the first
# outbound of its chain, e.g. main-2-out). Bytes of connections that ended
# between two polls are shared out like the seen ones. Kept since the agent
# started in $RUN/traffic/state.json; "links" also keeps them per
# "<section><TAB><link>", the link behind each tag at the time of the poll, so
# a reorder of the links doesn't move bytes to another server.
traffic_poll() {
  _cfg=$(uci -q get podkop.settings.config_path); [ -n "$_cfg" ] || _cfg=/etc/sing-box/config.json
  _addr=$(jq -r '.experimental.clash_api.external_controller // empty' "$_cfg" 2>/dev/null)
  _sec=$(jq -r '.experimental.clash_api.secret // empty' "$_cfg" 2>/dev/null)
  [ -n "$_addr" ] || return 0
  if [ -n "$_sec" ]; then _c=$(curl -s --max-time 5 -H "Authorization: Bearer $_sec" "http://$_addr/connections")
  else _c=$(curl -s --max-time 5 "http://$_addr/connections"); fi
  [ -n "$_c" ] || return 0
  printf '%s' "$_c" > "$RUN/conns.json" && sections_learn "$RUN/conns.json"; rm -f "$RUN/conns.json"
  # tag -> "<section><TAB><link>", named like tag_link does (and "<section>-out" for a url section)
  _tl=$(seen_json | jq -c '
    def lst: if . == null then [] elif type == "array" then . else [.] end;
    [.sections[] | select(.options.connection_type == "proxy") | .name as $s | .options as $o
    | if $o.proxy_config_type == "urltest" then
        ($o.urltest_proxy_links | lst | to_entries[] | {key: "\($s)-\(.key + 1)-out", value: "\($s)\t\(.value)"}),
        ($o.urltest_fallback_links | lst | to_entries[] | {key: "\($s)-fallback-\(.key + 1)-out", value: "\($s)\t\(.value)"})
      elif $o.proxy_config_type == "selector" then
        ($o.selector_proxy_links | lst | to_entries[] | {key: "\($s)-\(.key + 1)-out", value: "\($s)\t\(.value)"})
      elif $o.proxy_config_type == "url" and ($o.proxy_string // "") != "" then
        {key: "\($s)-out", value: "\($s)\t\($o.proxy_string)"}
      else empty end] | from_entries')
  [ -n "$_tl" ] || _tl='{}'
  _d="$RUN/traffic"; mkdir -p "$_d"
  # a missing, empty or broken state starts over
  jq -e .servers "$_d/state.json" >/dev/null 2>&1 || jq -nc --arg t "$(now)" '{since: $t, total: 0, conns: {}, servers: {}, links: {}}' > "$_d/state.json"
  # (in a file: one argument holds 128 KB at most, a few hundred links are more)
  printf '%s' "$_tl" > "$_d/links.json"
  printf '%s' "$_c" | jq -c --slurpfile st "$_d/state.json" --slurpfile tlf "$_d/links.json" '
    $st[0] as $s | $tlf[0] as $tl
    | [.connections[]? | {id, b: ((.upload // 0) + (.download // 0)), tag: ((.chains // [])[0] // "")}] as $cs
    | ((.uploadTotal // 0) + (.downloadTotal // 0)) as $total
    | [$cs[] | {tag, d: ([.b - ($s.conns[.id] // 0), 0] | max)}] as $ds
    | ([$ds[].d] | add // 0) as $seen
    | ([(if $total >= $s.total then $total - $s.total else $total end) - $seen, 0] | max) as $gone
    | [$ds[] | {tag, n: (.d + (if $seen > 0 then $gone * .d / $seen else 0 end) | floor)}] as $ns
    | {since: $s.since, total: $total, conns: ($cs | map({key: .id, value: .b}) | from_entries),
       servers: (reduce $ns[] as $x ($s.servers; .[$x.tag] += $x.n)
                 | if $seen == 0 and $gone > 0 then .[""] += $gone else . end),
       # only the links podkop has now: the file in RAM does not grow as links come and go
       links: (reduce $ns[] as $x ($s.links // {}; if $tl[$x.tag] then .[$tl[$x.tag]] += $x.n else . end)
               | ([$tl[]] | map({key: ., value: true}) | from_entries) as $live
               | with_entries(select($live[.key])))}' > "$_d/state.new" 2>/dev/null &&
    mv "$_d/state.new" "$_d/state.json"
}

# guard_watch <daemon pid>: a service event of sing-box or podkop (start,
# stop, crash) wakes the daemon at once, for the strict guard; ubusd restarts
# are followed; it ends with the daemon
guard_watch() {
  while kill -0 "$1" 2>/dev/null; do
    ubus -S subscribe service 2>/dev/null | while IFS= read -r _l; do
      case "$_l" in *'"service":"sing-box"'*|*'"service":"podkop"'*) touch "$RUN/guard/poke" ;; esac
      kill -0 "$1" 2>/dev/null || exit 0
    done
    sleep 5
  done
}

# kill_children <pid>: its children (the watcher's ubus and read loop), then it
kill_children() {
  for _p in /proc/[0-9]*; do
    { read -r _ _ _ _pp _ < "$_p/stat"; } 2>/dev/null || continue     # (a process that just ended)
    [ "$_pp" = "$1" ] && kill "${_p#/proc/}" 2>/dev/null
  done
  kill "$1" 2>/dev/null
}

# tidy: what killed commands left in RAM (at the daemon's start and about
# once an hour): sing-box processes of connection checks whose command is
# gone (20 MB each), and the folders of checks and exit-IP lookups
tidy() {
  for _p in /proc/[0-9]*; do
    { read -r _ _ _ _pp _ < "$_p/stat"; } 2>/dev/null || continue     # (a process that just ended)
    [ "$_pp" = 1 ] || continue
    case "$(tr '\0' ' ' < "$_p/cmdline" 2>/dev/null)" in
      "sing-box run -c $RUN/check."*) kill "${_p#/proc/}" 2>/dev/null && logger -t podkop-agent "ended a leftover connection check" ;;
      *"/nfqws2 --qnum=$((300 + ZAPRET_TEST)) "*) kill "${_p#/proc/}" 2>/dev/null && logger -t podkop-agent "ended a leftover zapret search" ;;
    esac
  done
  find "$RUN" -maxdepth 1 \( -name 'exits.*' -o -name 'check.*' -o -name 'hot.*' -o -name 'status.*' \) -mmin +30 \
    -exec rm -rf {} + 2>/dev/null
}

# clock_ok: NTP has set the clock since the boot (install.sh's hotplug script
# leaves the mark), or the router has been up for 15 minutes (no NTP here).
# A router has no battery clock: after a power cut it starts with an old
# date, TLS to the servers fails until NTP answers, and every group looks dead.
CLOCK_MARK=/tmp/podkop-clock
clock_ok() { [ -f "$CLOCK_MARK" ] || [ "$(cut -d . -f 1 /proc/uptime)" -ge 900 ]; }

daemon() {
  mkdir -p "$RUN/jobs" "$RUN/guard" "$ETC"
  event agent_started "$(jq -nc --arg v "$AGENT_VERSION" '{version: $v}')"
  undo_interrupted
  _last=""; _down=0; _heal=0; _pintry=0
  guard_watch $$ & _gw=$!
  trap 'kill_children "$_gw"; exit 0' TERM INT
  _tidy=0
  while :; do
    # the daemon's sign of life (RAM): "status" says how old it is
    : > "$RUN/beat"
    [ "$_tidy" = 0 ] && tidy
    _tidy=$(( (_tidy + 1) % 240 ))
    _w=0
    while [ "$_w" -lt 15 ] && [ ! -f "$RUN/guard/poke" ]; do sleep 1; _w=$((_w + 1)); done
    rm -f "$RUN/guard/poke"
    # safe mode: plain podkop, the daemon only shows that it is alive
    if safe_mode; then _last=""; _down=0; continue; fi
    if command -v guard_sync >/dev/null 2>&1; then
      # not while an apply or a recovery restarts podkop: they raise it themselves
      flock -n "$RUN/apply.lock" true && guard_sync
    fi
    [ "$_w" -lt 15 ] && continue     # woken by a service event: the guard only
    vpn_watch
    zapret_watch
    [ -n "$(singbox_pid)" ] && traffic_poll
    if [ -f "$ETC/paused" ] || ! podkop_enabled; then _down=0; continue; fi
    # a change or a recovery holds the lock; podkop's own start takes a while
    flock -n "$RUN/apply.lock" true || continue
    # an apply killed while the daemon runs (e.g. out of memory)
    [ -s "$ETC/apply-pending" ] && { undo_interrupted; continue; }
    [ "$(podkop_start_state)" = running ] && continue
    _pid=$(singbox_pid)
    if [ -n "$_pid" ]; then
      if command -v reliability_expire >/dev/null 2>&1; then reliability_expire; fi
      # dead groups, every 30 s
      _heal=$(( (_heal + 1) % 2 ))
      if [ "$_heal" = 0 ] && command -v heal_check >/dev/null 2>&1 && clock_ok; then heal_check; fi
      [ "$_down" -ge 2 ] && event podkop_up
      _down=0
      # tried every round until the Clash API answers and the pins are back;
      # a reload drops the pins, so they go back the round after it
      if [ "$_pid" != "$_last" ]; then
        _r=$( (flock -n 9 || exit 1; health_on) 9> "$RUN/apply.lock") || continue
        [ "$_r" = reloaded ] && continue
        # a pin that cannot be set (its server left the group) is tried a few
        # rounds, not for ever: every try runs health_on again
        if [ -n "$(proxies)" ]; then
          if reapply_pins || [ "$_pintry" -ge 4 ]; then _last=$_pid; _pintry=0; else _pintry=$((_pintry + 1)); fi
        fi
      fi
      continue
    fi
    # podkop's own start at boot can wait for the network for a while
    [ "$(cut -d . -f 1 /proc/uptime)" -lt 180 ] && continue
    _down=$((_down + 1))
    [ "$_down" = 2 ] && event podkop_down "$(jq -nc --arg f "$(failsafe_recent)" \
      '{failsafe: (if $f == "" then null else $f end)}')"
    [ "$_down" -ge 2 ] && recover
  done
}

# upgrade: the manager sends its own router files (stdin {"files": {name:
# text}}); install.sh --upgrade --src runs them in as a job, so the answer
# comes before the agent restarts -> {job}; "job <id>" follows it
UPGRADE_FILES="podkop-agent podkop-agent.init probe.sh reliability.sh install.sh"
cmd_upgrade() {
  mkdir -p "$RUN/jobs"
  _d=$(mktemp -d "$RUN/upgrade.XXXXXX") || fail error "cannot create upgrade directory"
  head -c 2097152 > "$_d/in"
  for _f in $UPGRADE_FILES; do
    jq -je --arg f "$_f" '.files[$f] | select(type == "string" and length > 0)' "$_d/in" > "$_d/$_f" 2>/dev/null ||
      { rm -rf "$_d"; fail bad_request "expected {\"files\": {\"$_f\": \"...\", ...}}"; }
  done
  rm -f "$_d/in"
  flock -n "$RUN/install.lock" true || { rm -rf "$_d"; fail busy "an agent upgrade is already running"; }
  _id=$(job_new upgrade)
  echo "$_d" > "$RUN/jobs/$_id.dir"
  spawn _run-upgrade "$_id"
  reply "$(jq -nc --arg id "$_id" '{job: $id}')"
}

run_upgrade() {
  _id=$1; _d=$(cat "$RUN/jobs/$_id.dir" 2>/dev/null)
  if [ -z "$_d" ] || [ ! -f "$_d/install.sh" ]; then job_end "$_id" failed "the upgrade files are gone"; return; fi
  job_set "$_id" '.state = "running"'
  if PODKOP_INSTALL_WAIT=120 sh "$_d/install.sh" --upgrade --src "$_d" > "$_d/log" 2>&1; then
    job_end "$_id" "done" "$(tail -n 1 "$_d/log")" \
      "$(jq -nc --arg v "$(sed -n 's/^AGENT_VERSION="\(.*\)"/\1/p' /usr/bin/podkop-agent)" '{version: $v}')"
  else
    _m=$(grep '^error: ' "$_d/log" | tail -n 1 | cut -c 8-); [ -n "$_m" ] || _m=$(tail -n 1 "$_d/log")
    job_end "$_id" failed "${_m:-the upgrade failed}"
  fi
  rm -rf "$_d" "$RUN/jobs/$_id.dir"
}

# --- IPv6 -----------------------------------------------------------------------

# podkop routes IPv4 only. A LAN that gets IPv6 (router advertisements or
# DHCPv6 from this router, and a default IPv6 route to the provider) lets a
# device that resolves names itself reach any site over IPv6, past podkop.
# ipv6_json: {lan: the LAN gets IPv6, blocked: our firewall rule is there}
IPV6_RULE=podkop_agent_ipv6_block
ipv6_json() {
  _ra=0
  ubus call uci get '{"config":"dhcp","type":"dhcp"}' 2>/dev/null |
    jq -e '[.values[]? | (.ra // ""), (.dhcpv6 // "")] | any(. == "server" or . == "hybrid")' >/dev/null 2>&1 && _ra=1
  _rt=0; [ -n "$(ip -6 route show default 2>/dev/null)" ] && _rt=1
  _bl=0; uci -q get "firewall.$IPV6_RULE" >/dev/null && _bl=1
  jq -nc --arg ra "$_ra" --arg rt "$_rt" --arg bl "$_bl" '{lan: ($ra == "1" and $rt == "1"), blocked: ($bl == "1")}'
}

# ipv6 on|off: a firewall rule (REJECT, so devices fall back to IPv4 at once)
# for IPv6 forwarded from the LAN to the WAN; written only when it changes
cmd_ipv6() {
  case "${1:-}" in on|off) ;; *) fail bad_request "usage: ipv6 on|off" ;; esac
  _have=0; uci -q get "firewall.$IPV6_RULE" >/dev/null && _have=1
  if [ "$1" = on ] && [ "$_have" = 0 ]; then
    uci set "firewall.$IPV6_RULE=rule"
    uci set "firewall.$IPV6_RULE.name=podkop-agent: no IPv6 from the LAN to the internet"
    uci set "firewall.$IPV6_RULE.family=ipv6"
    uci set "firewall.$IPV6_RULE.src=lan"
    uci set "firewall.$IPV6_RULE.dest=wan"
    uci set "firewall.$IPV6_RULE.proto=all"
    uci set "firewall.$IPV6_RULE.target=REJECT"
    if ! { uci commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1; }; then fail error "could not write the firewall rule"; fi
    event ipv6_block '{"blocked":true}'
  elif [ "$1" = off ] && [ "$_have" = 1 ]; then
    uci -q delete "firewall.$IPV6_RULE"
    if ! { uci commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1; }; then fail error "could not remove the firewall rule"; fi
    event ipv6_block '{"blocked":false}'
  fi
  reply "$(ipv6_json)"
}

# --- the router's DNS for every device ------------------------------------------------

# podkop's rules by domain work through the router's DNS (it answers with
# addresses that lead into sing-box). A device that asks another DNS server
# gets the real addresses and goes around those rules. dns-guard on|off:
# three firewall sections (written only when they change):
#   plain DNS (port 53) from the LAN to anywhere is answered by the router,
#   DNS over TLS (port 853) is refused,
#   DNS over HTTPS to the well-known public resolvers (port 443) is refused.
# IPv4; over IPv6 the "ipv6" block covers it. A list of resolvers is never
# complete: a resolver that is not in it still gets through.
DNS_RULES="podkop_agent_dns_redirect podkop_agent_dns_dot podkop_agent_dns_doh"
DNS_DOH="1.1.1.1 1.0.0.1 1.1.1.2 1.0.0.2 1.1.1.3 1.0.0.3 8.8.8.8 8.8.4.4 9.9.9.9 149.112.112.112 9.9.9.10 149.112.112.10
 9.9.9.11 149.112.112.11 94.140.14.14 94.140.15.15 94.140.14.15 94.140.15.16 94.140.14.140 94.140.14.141
 208.67.222.222 208.67.220.220 208.67.222.123 208.67.220.123 77.88.8.8 77.88.8.1 77.88.8.88 77.88.8.2 77.88.8.7 77.88.8.3
 194.242.2.2 185.222.222.222 45.11.45.11 45.90.28.0/24 45.90.30.0/24 185.228.168.9 185.228.169.9 185.228.168.168"
dns_json() {
  _dn=0; for _dr in $DNS_RULES; do uci -q get "firewall.$_dr" >/dev/null && _dn=$((_dn + 1)); done
  jq -nc --arg n "$_dn" '{guard: ($n == "3")}'
}
cmd_dns_guard() {
  case "${1:-}" in on|off) ;; *) fail bad_request "usage: dns-guard on|off" ;; esac
  _have=$(dns_json | jq -r .guard)
  if [ "$1" = on ] && [ "$_have" = false ]; then
    for _dr in $DNS_RULES; do uci -q delete "firewall.$_dr"; done
    uci set firewall.podkop_agent_dns_redirect=redirect
    uci set firewall.podkop_agent_dns_redirect.name="podkop-agent: the LAN's DNS goes to the router"
    uci set firewall.podkop_agent_dns_redirect.family=ipv4
    uci set firewall.podkop_agent_dns_redirect.src=lan
    uci set firewall.podkop_agent_dns_redirect.src_dport=53
    uci set firewall.podkop_agent_dns_redirect.proto='tcp udp'
    uci set firewall.podkop_agent_dns_redirect.target=DNAT
    uci set firewall.podkop_agent_dns_dot=rule
    uci set firewall.podkop_agent_dns_dot.name="podkop-agent: no DNS over TLS from the LAN"
    uci set firewall.podkop_agent_dns_dot.src=lan
    uci set firewall.podkop_agent_dns_dot.dest=wan
    uci set firewall.podkop_agent_dns_dot.dest_port=853
    uci set firewall.podkop_agent_dns_dot.proto='tcp udp'
    uci set firewall.podkop_agent_dns_dot.target=REJECT
    uci set firewall.podkop_agent_dns_doh=rule
    uci set firewall.podkop_agent_dns_doh.name="podkop-agent: no DNS over HTTPS to public resolvers from the LAN"
    uci set firewall.podkop_agent_dns_doh.family=ipv4
    uci set firewall.podkop_agent_dns_doh.src=lan
    uci set firewall.podkop_agent_dns_doh.dest=wan
    uci set firewall.podkop_agent_dns_doh.dest_port=443
    uci set firewall.podkop_agent_dns_doh.proto='tcp udp'
    uci set firewall.podkop_agent_dns_doh.target=REJECT
    for _da in $DNS_DOH; do uci add_list firewall.podkop_agent_dns_doh.dest_ip="$_da"; done
    if ! { uci commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1; }; then fail error "could not write the firewall rules"; fi
    event dns_guard '{"on":true}'
  elif [ "$1" = off ] && [ "$(for _dr in $DNS_RULES; do uci -q get "firewall.$_dr"; done)" != "" ]; then
    for _dr in $DNS_RULES; do uci -q delete "firewall.$_dr"; done
    if ! { uci commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1; }; then fail error "could not remove the firewall rules"; fi
    event dns_guard '{"on":false}'
  fi
  reply "$(dns_json)"
}

# --- OpenVPN client -----------------------------------------------------------------

# An OpenVPN tunnel (device pkvpn) that podkop's VPN rules send their sites
# through (connection type vpn, interface pkvpn). Its own procd service,
# podkop-vpn, runs it while $VPN_DIR/enabled is there. Routes from the server
# are ignored (route-nopull), so only the rules' sites use the tunnel; while
# it is down they fail (sing-box can't bind to a missing device), they never
# go out direct. $VPN_DIR/allow: {"*": [addresses]}: only those LAN devices
# use the rules of the tunnel (the others go on as if they weren't there);
# a rule's own name instead of "*" limits that rule only.
VPN_DIR=$ETC/vpn
VPN_DEV=pkvpn
VPN_INIT=/etc/init.d/podkop-vpn
VPN_PKGS="openvpn-openssl kmod-tun"
# directives the manager's config may not set: ours, scripts, files, routes
VPN_DENY="dev dev-type dev-node auth-user-pass auth-nocache script-security up down route-up route-pre-down ipchange
 tls-verify plugin learn-address client-connect client-disconnect auth-user-pass-verify log log-append status
 writepid daemon cd chroot config syslog management management-client-auth management-hold management-query-passwords
 redirect-gateway route route-ipv6 route-nopull route-noexec pull-filter iproute user group tmp-dir askpass"
# directives that name a file: only inline (<ca>...</ca>) works
VPN_FILES="ca cert key tls-auth tls-crypt tls-crypt-v2 pkcs12 secret dh crl-verify extra-certs http-proxy-user-pass"

vpn_init_text() {
  cat <<'EOF'
#!/bin/sh /etc/rc.common
# podkop-vpn: the OpenVPN client of podkop-agent (podkop-manager, VPN page)
START=90
USE_PROCD=1
D=/etc/podkop-agent/vpn
start_service() {
  [ -f "$D/enabled" ] && [ -s "$D/client.conf" ] && [ -x /usr/sbin/openvpn ] || return 0
  procd_open_instance
  procd_set_param command /usr/sbin/openvpn --cd "$D" --config client.conf
  # openvpn waits out network trouble by itself and exits only on a fatal
  # error (wrong password, bad config): a few tries, not for ever (account
  # lockout); the agent's daemon starts it again later unless the login failed
  procd_set_param respawn 300 10 3
  procd_close_instance
}
EOF
}

# vpn_clean: the manager's .ovpn on stdin -> the lines we keep; exit 2 with
# "file: <directives>" on stderr when it names files instead of inline blocks
vpn_clean() {
  awk -v deny="$(printf '%s' "$VPN_DENY" | tr '\n' ' ')" -v files="$VPN_FILES" '
    function has(list, w) { return index(" " list " ", " " w " ") > 0 }
    { sub(/\r$/, "") }
    blk != "" { if ($0 ~ "^[ \t]*</" blk ">[ \t]*$") { if (!drop) print; blk = ""; next } if (!drop) print; next }
    /^[ \t]*<[A-Za-z0-9-]+>[ \t]*$/ { blk = $0; gsub(/[ \t<>]/, "", blk); blk = tolower(blk); drop = has(deny, blk); if (!drop) print; next }
    /^[ \t]*([#;]|$)/ { next }
    { w = tolower($1); sub(/^--/, "", w)
      if (has(deny, w)) next
      if (has(files, w) && $2 != "[inline]") { bad = bad " " w; next }
      print }
    END { if (blk != "") { print "unclosed <" blk ">" > "/dev/stderr"; exit 2 }
          if (bad != "") { print "file:" bad > "/dev/stderr"; exit 2 } }'
}

# vpn_build: client.conf = the manager's config + our part
vpn_build() {
  {
    cat "$VPN_DIR/source.conf"
    echo "# --- podkop-agent ---"
    echo "dev $VPN_DEV"
    echo "dev-type tun"
    echo "route-nopull"
    # dropped before route-nopull refuses them one by one as "Options error"
    echo 'pull-filter ignore "redirect-gateway"'
    echo 'pull-filter ignore "route"'
    echo 'pull-filter ignore "dhcp-option"'
    echo 'pull-filter ignore "block-outside-dns"'
    echo "script-security 1"
    echo "syslog podkop-vpn"
    if [ -s "$VPN_DIR/auth" ]; then echo "auth-user-pass $VPN_DIR/auth"; fi
  } > "$VPN_DIR/client.conf.t" || return 1
  if cmp -s "$VPN_DIR/client.conf.t" "$VPN_DIR/client.conf"; then rm -f "$VPN_DIR/client.conf.t"; return 1; fi
  mv "$VPN_DIR/client.conf.t" "$VPN_DIR/client.conf"
}

vpn_installed() { [ -x /usr/sbin/openvpn ] && { [ -e /dev/net/tun ] || modprobe tun >/dev/null 2>&1; [ -e /dev/net/tun ]; }; }

# vpn_init: our service file, written only when it differs
vpn_init() {
  vpn_init_text > "$RUN/podkop-vpn.init"
  if ! cmp -s "$RUN/podkop-vpn.init" "$VPN_INIT"; then
    { cp "$RUN/podkop-vpn.init" "$VPN_INIT.t" && chmod 755 "$VPN_INIT.t" && mv "$VPN_INIT.t" "$VPN_INIT"; } || return 1
  fi
  rm -f "$RUN/podkop-vpn.init"
  "$VPN_INIT" enabled 2>/dev/null || "$VPN_INIT" enable
}

vpn_allow_json() { if [ -s "$VPN_DIR/allow" ]; then cat "$VPN_DIR/allow"; else echo '{}'; fi; }

# vpn_filter <sing-box config> <out>: the rules of $VPN_DIR/allow match only
# their devices (podkop's own rules for "fully routed IPs" stay as they are)
vpn_filter() {
  if [ ! -s "$VPN_DIR/allow" ]; then cp "$1" "$2"; return; fi
  jq --argjson a "$(vpn_allow_json)" --arg dev "$VPN_DEV" '
    [.outbounds[]? | select(.bind_interface == $dev) | .tag] as $vpn
    | if (.route.rules | type) == "array" then .route.rules |= map(
      (.outbound // "") as $o
      | ($o | if endswith("-out") then .[:-4] else "" end) as $s
      | (($a[$s] // []) + (if $vpn | index($o) then ($a["*"] // []) else [] end) | unique) as $ips
      | if $s != "" and .source_ip_cidr == null and ($ips | length) > 0
        then . + {source_ip_cidr: $ips} else . end) else . end' "$1" > "$2"
}

vpn_pid() { ubus call service list '{"name":"podkop-vpn"}' 2>/dev/null | jq -r '.["podkop-vpn"].instances[]?.pid // empty' | head -n 1; }

# vpn_pushed <pid>: what the server offered this openvpn, from its log, kept
# in $RUN/vpn.push (lines: pid, gateway, DNS); we take neither by ourselves
vpn_pushed() {
  [ -n "$1" ] || { rm -f "$RUN/vpn.push"; return; }
  if [ "$(sed -n 1p "$RUN/vpn.push" 2>/dev/null)" = "$1" ] && [ -n "$(sed -n 2p "$RUN/vpn.push")" ]; then return; fi
  logread -e podkop-vpn 2>/dev/null | grep -F "podkop-vpn[$1]" > "$RUN/vpn.push.log"
  { echo "$1"
    grep -o 'route-gateway [0-9.]*' "$RUN/vpn.push.log" | tail -n 1 | cut -d ' ' -f 2 | grep . || echo
    grep -o 'dhcp-option DNS [0-9.]*' "$RUN/vpn.push.log" | tail -n 1 | cut -d ' ' -f 3 | grep . || echo
  } > "$RUN/vpn.push"
  rm -f "$RUN/vpn.push.log"
}

# vpn_watch, every daemon round (15 s): events when the tunnel goes down (a
# minute without an address) and comes back; a tunnel whose gateway answered
# and then is silent for 3 rounds is restarted at once (the server's own
# timeout is often 2 minutes of hanging sites)
_vdown=0; _valert=0; _vseen=""; _vstrike=0
vpn_watch() {
  if [ ! -f "$VPN_DIR/enabled" ]; then _vdown=0; _valert=0; _vseen=""; _vstrike=0; return 0; fi
  _wp=$(vpn_pid)
  _wa=$(ip -4 -o addr show dev "$VPN_DEV" 2>/dev/null | awk '{ print $4; exit }')
  if [ -z "$_wa" ]; then
    _vdown=$((_vdown + 1)); _vseen=""; _vstrike=0
    if [ "$_vdown" = 4 ] && [ "$_valert" = 0 ]; then
      _valert=1
      event vpn_down "$(jq -nc --arg p "$_wp" --arg l "$(logread -e podkop-vpn 2>/dev/null | tail -n 1 | sed 's/^.*podkop-vpn[^:]*: //')" \
        '{running: ($p != ""), last: $l}')"
    fi
    # procd gave up (a fatal error at start): again every 5 minutes, but never
    # after a refused login
    if [ -z "$_wp" ] && [ $((_vdown % 20)) = 0 ] && [ -x "$VPN_INIT" ] &&
       ! logread -e podkop-vpn 2>/dev/null | tail -n 20 | grep -q AUTH_FAILED; then
      logger -t podkop-agent "VPN: OpenVPN is not running, starting it again"
      "$VPN_INIT" restart >/dev/null 2>&1 7>&- 8>&- 9>&-
    fi
    return 0
  fi
  [ "$_valert" = 1 ] && event vpn_up "$(jq -nc --arg a "$_wa" '{address: $a}')"
  _vdown=0; _valert=0
  vpn_pushed "$_wp"; _wg=$(sed -n 2p "$RUN/vpn.push" 2>/dev/null)
  [ -n "$_wg" ] || return 0
  if ping -c 1 -W 2 -I "$VPN_DEV" "$_wg" >/dev/null 2>&1; then _vseen=$_wp; _vstrike=0
  elif [ -n "$_wp" ] && [ "$_vseen" = "$_wp" ]; then
    _vstrike=$((_vstrike + 1))
    if [ "$_vstrike" -ge 3 ]; then
      _vstrike=0; _vseen=""
      logger -t podkop-agent "VPN: gateway $_wg silent for 3 rounds, reconnecting"
      kill -USR1 "$_wp" 2>/dev/null && event vpn_restart "$(jq -nc --arg g "$_wg" '{gateway: $g}')"
    fi
  fi
  return 0
}

vpn_status() {
  _vu=""; _vr=""
  [ -s "$VPN_DIR/auth" ] && _vu=$(head -n 1 "$VPN_DIR/auth")
  [ -s "$VPN_DIR/source.conf" ] && _vr=$(awk '$1 == "remote" { print $2 ($3 != "" ? ":" $3 : "") ($4 != "" ? " " $4 : ""); exit }' "$VPN_DIR/source.conf")
  _vp=$(vpn_pid); vpn_pushed "$_vp"
  _va=$(ip -4 -o addr show dev "$VPN_DEV" 2>/dev/null | awk '{ print $4; exit }')
  _vl=$(logread -e podkop-vpn 2>/dev/null | tail -n 30 | jq -Rsc 'split("\n") | map(select(. != ""))')
  _vi=false; vpn_installed && _vi=true
  jq -nc --argjson inst "$_vi" --arg u "$_vu" --arg r "$_vr" --arg p "$_vp" --arg a "$_va" --arg dev "$VPN_DEV" \
    --argjson allow "$(vpn_allow_json)" --argjson log "${_vl:-[]}" \
    --arg conf "$([ -s "$VPN_DIR/source.conf" ] && echo 1)" --arg en "$([ -f "$VPN_DIR/enabled" ] && echo 1)" \
    --arg pw "$(sed -n 2p "$VPN_DIR/auth" 2>/dev/null | grep -c .)" --arg dns "$(sed -n 3p "$RUN/vpn.push" 2>/dev/null)" \
    '{installed: $inst, configured: ($conf == "1"), enabled: ($en == "1"), running: ($p != ""), up: ($a != ""),
      address: (if $a == "" then null else $a end), remote: (if $r == "" then null else $r end), device: $dev,
      username: $u, password_set: ($pw == "1"), allow: $allow, log: $log,
      dns: (if $dns == "" then null else $dns end)}'
}

# vpn test: stdin {"host": name, "dns": address or ""}: does https://<host>
# open through the tunnel, its name resolved by that DNS server through the
# tunnel (or, without one, by podkop's bootstrap server, as a rule without
# its own DNS server does)? A sing-box of its own, nothing of podkop changes
# -> {ok, reason: "" | "dns" | "timeout" | "connect" | "down", error}
vpn_test() {
  _tq=$(head -c 4096)
  _th=$(printf '%s' "$_tq" | jq -r '.host // ""' 2>/dev/null); _td=$(printf '%s' "$_tq" | jq -r '.dns // ""' 2>/dev/null)
  case "$_th" in ""|*[!A-Za-z0-9.-]*) fail bad_request "host name expected" ;; esac
  case "$_td" in *[!0-9.]*) fail bad_request "dns must be an IPv4 address" ;; esac
  [ -n "$(ip -4 -o addr show dev "$VPN_DEV" 2>/dev/null)" ] ||
    reply '{"ok":false,"reason":"down","error":"the VPN is not connected"}'
  _tf="$RUN/vpn-test.$$"
  if [ -n "$_td" ]; then _ts=$(jq -nc --arg d "$_td" '{type: "udp", tag: "d", server: $d, detour: "vpn"}')
  else _tb=$(uci -q get podkop.settings.bootstrap_dns_server); _ts=$(jq -nc --arg d "${_tb:-77.88.8.8}" '{type: "udp", tag: "d", server: $d}'); fi
  jq -nc --arg dev "$VPN_DEV" --argjson s "$_ts" '{log: {disabled: true}, dns: {servers: [$s]},
    outbounds: [{type: "direct", tag: "vpn", bind_interface: $dev, domain_resolver: "d"}],
    route: {final: "vpn", default_domain_resolver: "d"}}' > "$_tf.json"
  sing-box tools fetch -c "$_tf.json" "https://$_th/" > /dev/null 2> "$_tf.err" &
  _tp=$!; _tw=0
  while kill -0 "$_tp" 2>/dev/null && [ "$_tw" -lt 10 ]; do sleep 1; _tw=$((_tw + 1)); done
  if kill "$_tp" 2>/dev/null; then wait "$_tp" 2>/dev/null; _tr=124; else wait "$_tp" 2>/dev/null; _tr=$?; fi
  _te=$(tail -n 1 "$_tf.err" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g; s/^FATAL\[[0-9]*\] //' | cut -c 1-300)
  rm -f "$_tf.json" "$_tf.err"
  # the site answered with a certificate we don't know (a company's own CA): it is reachable
  case "$_te" in *x509*|*certificate*) _tr=0 ;; esac
  if [ "$_tr" = 0 ]; then reply '{"ok":true,"reason":"","error":""}'; fi
  case "$_tr:$_te" in 124:*) _tn=timeout; _te="no answer in 10 s" ;; *lookup*) _tn=dns ;; *) _tn=connect ;; esac
  reply "$(jq -nc --arg r "$_tn" --arg e "$_te" '{ok: false, reason: $r, error: $e}')"
}

# vpn status | vpn set (stdin {config?, username?, password?, enabled?, allow?}) | vpn install (job) | vpn test
cmd_vpn() {
  case "${1:-status}" in
    status) reply "$(vpn_status)" ;;
    test) vpn_test ;;
    install)
      _id=$(job_new vpn-install); spawn _run-vpn-install "$_id"
      reply "$(jq -nc --arg id "$_id" '{job: $id}')" ;;
    set) ;;
    *) fail bad_request "usage: vpn status|set|install|test" ;;
  esac
  _vq=$(head -c 131072)
  printf '%s' "$_vq" | jq -e 'type == "object"
    and ((.config // "") | type == "string" and length <= 65536)
    and ((.username // "") | type == "string" and length <= 256 and (contains("\n") | not))
    and ((.password // "") | type == "string" and length <= 256 and (contains("\n") | not))
    and ((.enabled // false) | type == "boolean")
    and ((.allow // {}) | type == "object" and length <= 100 and all(to_entries[];
      (.key | . == "*" or length > 0 and (explode | all(. == 95 or (. >= 48 and . <= 57) or (. >= 65 and . <= 90) or (. >= 97 and . <= 122))))
      and (.value | type == "array" and length <= 256 and all(.[]; type == "string" and length > 0 and length <= 43
        and (explode | all(. == 46 or . == 47 or . == 58 or (. >= 48 and . <= 57) or (. >= 65 and . <= 70) or (. >= 97 and . <= 102)))))))' \
    >/dev/null 2>&1 || fail bad_request 'expected {"config", "username", "password", "enabled", "allow": {"rule": ["addresses"]}}'
  mkdir -p "$VPN_DIR" && chmod 700 "$VPN_DIR"
  _restart=0
  if printf '%s' "$_vq" | jq -e 'has("config")' >/dev/null; then
    printf '%s' "$_vq" | jq -j '.config' | vpn_clean > "$RUN/vpn.conf" 2> "$RUN/vpn.err" ||
      { _ve=$(cat "$RUN/vpn.err"); rm -f "$RUN/vpn.conf" "$RUN/vpn.err"
        case "$_ve" in file:*) fail bad_request "the config names files (${_ve#file: }); put them inline, like <ca>...</ca>" ;;
                       *) fail bad_request "${_ve:-the config could not be read}" ;; esac; }
    rm -f "$RUN/vpn.err"
    grep -qE '^[[:space:]]*remote[[:space:]]' "$RUN/vpn.conf" || { rm -f "$RUN/vpn.conf"; fail bad_request "the config has no remote line"; }
    cmp -s "$RUN/vpn.conf" "$VPN_DIR/source.conf" || { cp "$RUN/vpn.conf" "$VPN_DIR/source.conf.t" && mv "$VPN_DIR/source.conf.t" "$VPN_DIR/source.conf"; } ||
      { rm -f "$RUN/vpn.conf"; fail error "could not write the config"; }
    rm -f "$RUN/vpn.conf"
  fi
  if printf '%s' "$_vq" | jq -e 'has("username")' >/dev/null; then
    _vu=$(printf '%s' "$_vq" | jq -r '.username')
    if [ -z "$_vu" ]; then [ ! -f "$VPN_DIR/auth" ] || { rm -f "$VPN_DIR/auth"; _restart=1; }
    else
      # no password sent: the saved one stays
      _vw=$(printf '%s' "$_vq" | jq -r '.password // empty')
      [ -n "$_vw" ] || _vw=$(sed -n 2p "$VPN_DIR/auth" 2>/dev/null)
      [ -n "$_vw" ] || fail bad_request "a password is needed with the login"
      printf '%s\n%s\n' "$_vu" "$_vw" > "$RUN/vpn.auth"
      cmp -s "$RUN/vpn.auth" "$VPN_DIR/auth" || { cp "$RUN/vpn.auth" "$VPN_DIR/auth.t" && mv "$VPN_DIR/auth.t" "$VPN_DIR/auth" && _restart=1; } ||
        { rm -f "$RUN/vpn.auth"; fail error "could not write the login"; }
      rm -f "$RUN/vpn.auth"
    fi
  fi
  [ -s "$VPN_DIR/source.conf" ] && vpn_build && _restart=1
  if printf '%s' "$_vq" | jq -e 'has("enabled")' >/dev/null; then
    if printf '%s' "$_vq" | jq -e '.enabled' >/dev/null; then
      [ -s "$VPN_DIR/source.conf" ] || fail bad_request "import a config first"
      vpn_installed || fail not_installed "OpenVPN is not installed on the router"
      [ -f "$VPN_DIR/enabled" ] || { touch "$VPN_DIR/enabled"; _restart=1; event vpn '{"enabled":true}'; }
    elif [ -f "$VPN_DIR/enabled" ]; then rm -f "$VPN_DIR/enabled"; _restart=1; event vpn '{"enabled":false}'; fi
  fi
  if [ "$_restart" = 1 ] && vpn_installed; then
    vpn_init || fail error "could not write $VPN_INIT"
    "$VPN_INIT" restart >/dev/null 2>&1 7>&- 8>&- 9>&-
  fi
  if printf '%s' "$_vq" | jq -e 'has("allow")' >/dev/null; then
    printf '%s' "$_vq" | jq -cS '.allow | with_entries(.value |= unique) | with_entries(select(.value | length > 0))' > "$RUN/vpn.allow"
    if [ "$(cat "$RUN/vpn.allow")" = '{}' ]; then
      [ -f "$VPN_DIR/allow" ] && _allow=1 || _allow=0; rm -f "$VPN_DIR/allow" "$RUN/vpn.allow"
    elif cmp -s "$RUN/vpn.allow" "$VPN_DIR/allow"; then _allow=0; rm -f "$RUN/vpn.allow"
    else { cp "$RUN/vpn.allow" "$VPN_DIR/allow.t" && mv "$VPN_DIR/allow.t" "$VPN_DIR/allow"; } || fail error "could not write the devices"
      rm -f "$RUN/vpn.allow"; _allow=1; fi
    if [ "$_allow" = 1 ]; then
      event vpn_allow "$(jq -nc --argjson a "$(vpn_allow_json)" '{allow: $a}')"
      if [ -n "$(singbox_pid)" ]; then
        exec 9> "$RUN/apply.lock"; flock -n 9 || fail busy "an apply is in progress"
        _vh=$(hot_apply "devices of VPN rules changed") || { exec 9>&-; fail recovery_failed "sing-box did not take the change: $_vh"; }
        exec 9>&-
      fi
    fi
  fi
  reply "$(vpn_status)"
}

# vpn_proxy_up <port>: a sing-box of a server that answers now, as an HTTP
# proxy on 127.0.0.1:<port> (the router's own traffic isn't routed by podkop,
# and some providers cut the package servers off); its pid on stdout
vpn_proxy_up() {
  _fc=$(uci -q get podkop.settings.config_path); [ -n "$_fc" ] || _fc=/etc/sing-box/config.json
  proxies > "$RUN/vpn-px.json" 2>/dev/null
  jq -c --slurpfile p "$RUN/vpn-px.json" --argjson port "$1" '.outbounds as $all
    | ([$all[] | select(.type == "urltest") | ($p[0].proxies[.tag].now // "") as $n
        | select($n != "" and ((($p[0].proxies[$n].history // []) | last | (.delay // 0)) > 0)) | $n] | first) as $t
    | [$t | recurse(. as $x | ($all[] | select(.tag == $x) | .detour) // empty)] as $chain
    | {log: {disabled: true}, dns: {servers: [{type: "local", tag: "local"}]},
       inbounds: [{type: "mixed", tag: "pkg-in", listen: "127.0.0.1", listen_port: $port}],
       outbounds: [$all[] | select(.tag as $x | $chain | index($x)) | del(.domain_resolver)],
       route: {final: $t, default_domain_resolver: "local"}}
    | if (.outbounds | length) == 0 then error("no outbound") else . end' "$_fc" > "$RUN/vpn-px.cfg" 2>/dev/null ||
    { rm -f "$RUN/vpn-px.json" "$RUN/vpn-px.cfg"; return 1; }
  rm -f "$RUN/vpn-px.json"
  sing-box run -c "$RUN/vpn-px.cfg" >/dev/null 2>&1 &
  echo $!
}

# the packages, straight or through a server; kmod-tun needs no reboot
run_vpn_install() {
  _id=$1; _vl="$RUN/jobs/$_id.log"
  job_set "$_id" '.state = "running"'
  if command -v apk >/dev/null 2>&1; then _upd="apk update"; _add="apk add $VPN_PKGS"
  else _upd="opkg update"; _add="opkg install $VPN_PKGS"; fi
  # shellcheck disable=SC2086
  if ! { $_upd && $_add; } > "$_vl" 2>&1; then
    _port=$((20000 + $$ % 10000))
    if _pp=$(vpn_proxy_up "$_port"); then
      sleep 2
      # shellcheck disable=SC2086
      { http_proxy="http://127.0.0.1:$_port" https_proxy="http://127.0.0.1:$_port" sh -c "$_upd && $_add"; } >> "$_vl" 2>&1
      kill "$_pp" 2>/dev/null; rm -f "$RUN/vpn-px.cfg"
    fi
  fi
  if vpn_installed; then
    vpn_init >/dev/null 2>&1
    job_end "$_id" "done" "OpenVPN is installed"
  else
    _m=$(grep -iE 'error|unable|not found' "$_vl" | tail -n 1); [ -n "$_m" ] || _m=$(tail -n 1 "$_vl")
    job_end "$_id" failed "${_m:-the packages could not be installed}"
  fi
}

# --- zapret: DPI bypass on the direct path, the rule's servers as fallback --------------

# A zapret rule tries its sites without a server first. sing-box gets two
# outbounds for it: "<rule>-zapret-direct" (direct, with the rule's own mark)
# and "<rule>-zapret-out", a URLTest of that one whose fallback is the rule's
# usual "<rule>-out"; the rule's route rules send to the URLTest. nfqws2
# (bol-van/zapret2) gets the first packets of the marked connections only
# (nft table podkop_zapret) and changes them so the provider's filter lets
# them pass. When the test URL fails through zapret,
# the rule uses its servers until the test passes again.
#
# podkop lets the router's own traffic past its rules only with its mark
# 0x00200000 (exactly): connections to addresses of its subnet lists would
# go back into sing-box. So once nfqws2 has seen them, the packets of a zapret
# connection (and the ones nfqws2 makes) get that mark, before podkop's chain
# (priority mangle, -150). QUIC is refused on the direct path, so apps use
# TCP, which zapret handles. The table stays while there are zapret rules
# (the daemon puts it back): without it their traffic would loop.
# not under $ETC: nfqws2 drops its root rights after the start and must still
# read its Lua and fake files
ZAPRET_DIR=/etc/podkop-zapret
ZAPRET_RULES=$ZAPRET_DIR/rules.json   # {"<rule>": {"args": [...], "url", "name", "service", "n"}}
ZAPRET_INIT=/etc/init.d/podkop-zapret
ZAPRET_BASE=134217728                 # 0x08000000: a rule's mark is base + n, its queue 300 + n
ZAPRET_TEST=99                        # n of the strategy search
ZAPRET_INTERVAL=$ZAPRET_DIR/interval  # seconds between checks of a direct path (15..600, by 15; default 30)
ZAPRET_FAKE=0x40000000                # nfqws2's mark on the packets it makes (its default)
# options a strategy may not set: ours, or ones that leave the process unwatched
ZAPRET_DENY='["--qnum","--fwmark","--daemon","--pidfile","--user","--uid","--debug","--chdir","--writable","--intercept","--dry-run","--version","--lua-init"]'
ZAPRET_ARGS_OK='type == "array" and length > 0 and length <= 40 and all(.[]; type == "string" and length > 2 and length <= 600
  and startswith("--") and (explode | all(. >= 33 and . <= 126)) and ((split("=")[0]) as $o | $deny | index($o) | not))'

zapret_installed() { [ -x "$ZAPRET_DIR/nfqws2" ]; }
# the check interval: sing-box's URLTest and the agent's own test use the same one
zapret_interval() {
  _zi=$(cat "$ZAPRET_INTERVAL" 2>/dev/null)
  case "$_zi" in ""|*[!0-9]*) echo 30 ;; *) if [ "$_zi" -ge 15 ] && [ "$_zi" -le 600 ]; then echo $((_zi / 15 * 15)); else echo 30; fi ;; esac
}
zapret_rules_json() { if [ -s "$ZAPRET_RULES" ]; then cat "$ZAPRET_RULES"; else echo '{}'; fi; }
zapret_table() { nft list table inet podkop_zapret >/dev/null 2>&1; }

# zapret_nft_text <rules json>: the table for these rules and the search
zapret_nft_text() {
  printf '%s' "$1" | jq -r --argjson base "$ZAPRET_BASE" --argjson t "$ZAPRET_TEST" '
    ([.[] | .n] + [$t]) as $ns
    | "table inet podkop_zapret {",
      "  chain predefrag {", "    type filter hook output priority -401; policy accept;",
      "    meta mark & 0x40000000 != 0 tcp flags ! syn,rst,ack notrack", "  }",
      "  chain out_q {", "    type filter hook output priority -160; policy accept;",
      "    meta mark & 0xff000000 == 0x08000000 ct mark set meta mark",
      "    meta mark & 0xff000000 == 0x08000000 udp dport 443 counter reject",
      ($ns[] | "    meta mark \($base + .) tcp dport { 80, 443 } ct original packets 1-20 counter queue num \(300 + .) bypass"),
      "  }",
      "  chain out_fix {", "    type route hook output priority -155; policy accept;",
      "    ct mark & 0xff000000 == 0x08000000 meta mark set 0x00200000",
      "    meta mark & 0x40000000 != 0 meta mark set 0x00200000", "  }",
      "  chain in_q {", "    type filter hook input priority -160; policy accept;",
      "    icmp type time-exceeded ct mark & 0xff000000 == 0x08000000 drop",
      ($ns[] | "    ct mark \($base + .) tcp sport { 80, 443 } ct reply packets 1-10 queue num \(300 + .) bypass"),
      "  }", "}"'
}

# zapret_nft on|off: the table as the rules say (in one step), or none
zapret_nft() {
  if [ "${1:-on}" = off ]; then nft delete table inet podkop_zapret 2>/dev/null; return 0; fi
  { echo "table inet podkop_zapret"; echo "delete table inet podkop_zapret"; zapret_nft_text "$(zapret_rules_json)"; } | nft -f -
}

# zapret_run <n> <args...>: becomes nfqws2 on the queue of n; its directory
# is $ZAPRET_DIR/fake, so a strategy names fake files plainly
zapret_run() {
  _zq=$((300 + $1)); shift
  cd "$ZAPRET_DIR/fake" 2>/dev/null || cd "$ZAPRET_DIR" || exit 1
  _zl=""
  for _zf in zapret-lib zapret-antidpi zapret-auto; do
    { [ -f "$ZAPRET_DIR/lua/$_zf.lua.gz" ] || [ -f "$ZAPRET_DIR/lua/$_zf.lua" ]; } && _zl="$_zl --lua-init=@$ZAPRET_DIR/lua/$_zf.lua"
  done
  # shellcheck disable=SC2086   # our own paths, no spaces
  exec "$ZAPRET_DIR/nfqws2" --qnum="$_zq" --fwmark="$ZAPRET_FAKE" $_zl "$@"
}

# zapret_exec <rule json>: zapret_run with its options, one argument each
# (no shell word splitting or quoting: they were checked, one per line)
zapret_exec() {
  _zj=$1; _zn=$(printf '%s' "$_zj" | jq -r .n)
  set --
  while IFS= read -r _za; do [ -n "$_za" ] && set -- "$@" "$_za"; done <<EOF_ZA
$(printf '%s' "$_zj" | jq -r '.args[]')
EOF_ZA
  zapret_run "$_zn" "$@"
}

zapret_init_text() {
  cat <<'EOF'
#!/bin/sh /etc/rc.common
# podkop-zapret: nfqws2 of podkop-agent's zapret rules (podkop-manager, Zapret page)
START=95
USE_PROCD=1
R=/etc/podkop-zapret/rules.json
start_service() {
  [ -s "$R" ] || return 0
  # (an internal command: not when started from the manager's SSH session)
  env -u SSH_CONNECTION -u SSH_CLIENT -u SSH_ORIGINAL_COMMAND /usr/bin/podkop-agent _zapret-nft || return 1
  for r in $(jq -r 'keys[]' "$R"); do
    procd_open_instance "$r"
    procd_set_param command /usr/bin/podkop-agent _zapret-run "$r"
    procd_set_param respawn 3600 5 0
    procd_set_param stderr 1
    procd_close_instance
  done
}
EOF
}

zapret_init() {
  zapret_init_text > "$RUN/podkop-zapret.init"
  if ! cmp -s "$RUN/podkop-zapret.init" "$ZAPRET_INIT"; then
    { cp "$RUN/podkop-zapret.init" "$ZAPRET_INIT.t" && chmod 755 "$ZAPRET_INIT.t" && mv "$ZAPRET_INIT.t" "$ZAPRET_INIT"; } || return 1
  fi
  rm -f "$RUN/podkop-zapret.init"
  "$ZAPRET_INIT" enabled 2>/dev/null || "$ZAPRET_INIT" enable
}

# zapret_filter <sing-box config> <out>: the zapret rules' outbounds, and in
# front of each of their route rules two copies of it for the web only (TCP
# 80/443 sniffed as TLS or HTTP, and QUIC, which the nft table refuses so
# apps use TCP) that send to the zapret group; everything else the rule
# takes stays on its servers (zapret changes web connections only). A route
# rule that already names ports, networks or protocols is left alone. What
# an earlier round added goes first, so it can run again on its own output;
# kill-switch and protected rules are left as they are.
ZAPRET_JQ='
  def strip: .outbounds |= map(select((.tag // "") | (endswith("-zapret-out") or endswith("-zapret-direct")) | not))
    | if (.route.rules | type) == "array" then .route.rules |= map(select((.outbound // "") | endswith("-zapret-out") | not)) else . end;
  strip | [.outbounds[]?.tag] as $tags
  | reduce ($z | to_entries[] | select(.key as $k | ($skip | index($k) | not) and ($tags | index($k + "-out")))) as $r (.;
      ($r.key + "-zapret-out") as $g
      | .outbounds += [{type: "direct", tag: ($r.key + "-zapret-direct"), routing_mark: ($base + $r.value.n)},
                       {type: "urltest", tag: $g, outbounds: [$r.key + "-zapret-direct"],
                        fallbacks: [$r.key + "-out"], url: $r.value.url, interval: "\($iv)s", interrupt_exist_connections: true}]
      | if (.route.rules | type) == "array" then .route.rules |= [.[]
          | if .outbound == ($r.key + "-out") and .network == null and .port == null and .port_range == null and .protocol == null
            then (. + {network: ["tcp"], port: [80, 443], protocol: ["tls", "http"], outbound: $g}),
                 (. + {network: ["udp"], port: [443], outbound: $g}), .
            else . end] else . end)'
zapret_skip_json() { cat "$ETC/strict" "$ETC/protected" 2>/dev/null | jq -Rsc 'split("\n") | map(select(. != ""))'; }
zapret_filter() {
  _zz='{}'
  if [ -s "$ZAPRET_RULES" ] && zapret_installed; then
    # the table first: without it the rules would be left out of sing-box
    # (their traffic would loop), and nothing would put them back
    zapret_table || zapret_nft >/dev/null 2>&1
    zapret_table && _zz=$(zapret_rules_json)
  fi
  jq --argjson z "$_zz" --argjson skip "$(zapret_skip_json)" --argjson base "$ZAPRET_BASE" --argjson iv "$(zapret_interval)" "$ZAPRET_JQ" "$1" > "$2"
}

zapret_running() {
  ubus call service list '{"name":"podkop-zapret"}' 2>/dev/null |
    jq -c '[.["podkop-zapret"].instances // {} | to_entries[] | select(.value.running) | .key]' 2>/dev/null | grep . || echo '[]'
}

# zapret_watch, every daemon round: the table is back after anything removed
# it; a rule that moved to its servers (zapret's check fails) or back gives an
# event once the move has held for two rounds (a moment on the servers while
# sing-box's first test after a reload runs is not a move)
zapret_watch() {
  if [ ! -s "$ZAPRET_RULES" ] || ! zapret_installed; then rm -rf "$RUN/zapret"; return 0; fi
  mkdir -p "$RUN/zapret"
  # once per daemon: the service script of an older agent is brought up to
  # date (written only when it differs)
  [ -n "${_zinit:-}" ] || { zapret_init >/dev/null 2>&1; _zinit=1; }
  zapret_prune
  [ -s "$ZAPRET_RULES" ] || return 0
  zapret_table || { zapret_nft && logger -t podkop-agent "zapret: firewall table was missing, added again"; }
  # nfqws2: procd starts a crashed one again, but an older script gave up
  # after 5 crashes and a start at boot may have failed; "start" brings back
  # the instances that do not run and leaves the others alone (not more
  # often than every 2 minutes)
  _zdown=$(jq -r --argjson run "$(zapret_running)" 'keys - $run | join(" ")' "$ZAPRET_RULES" 2>/dev/null)
  if [ -n "$_zdown" ] && ! find "$RUN/zapret/started" -mmin -2 2>/dev/null | grep -q .; then
    : > "$RUN/zapret/started"
    "$ZAPRET_INIT" start >/dev/null 2>&1 7>&- 8>&- 9>&-
    logger -t podkop-agent "zapret: nfqws2 of $_zdown did not run, started again"
    event zapret_restarted "$(jq -nc --arg r "$_zdown" '{rules: ($r | split(" "))}')"
  fi
  # sing-box tests a URLTest only while connections use it: with no traffic a
  # failing zapret path would stay chosen (and the next connection fail), so
  # each rule's direct path is tested here at the same interval as sing-box's
  # own test (the daemon's rounds are 15 s)
  _zwt=$(( (${_zwt:-0} + 1) % ($(zapret_interval) / 15) ))
  if [ "$_zwt" = "$(( 1 % ($(zapret_interval) / 15) ))" ] && command -v clash_get >/dev/null 2>&1; then
    _wps=""
    for _wr in $(jq -r 'keys[]' "$ZAPRET_RULES" 2>/dev/null); do
      _wurl=$(jq -r --arg r "$_wr" '.[$r].url' "$ZAPRET_RULES")
      clash_get "/proxies/$_wr-zapret-direct/delay" --data-urlencode "url=$_wurl" --data "timeout=6000" >/dev/null 2>&1 &
      _wps="$_wps $!"
    done
    # their own pids only: a bare wait would wait for the guard's watcher too
    for _wpid in $_wps; do wait "$_wpid" 2>/dev/null; done
  fi
  _wp=$(proxies 2>/dev/null); [ -n "$_wp" ] || return 0
  zapret_repair "$_wp"
  printf '%s' "$_wp" | jq -r --argjson r "$(zapret_rules_json)" '.proxies as $p | $r | keys[]
    | . as $k | ($p[$k + "-zapret-out"].now // "") | select(. != "")
    | "\($k)\t\(if endswith("-zapret-direct") then "zapret" else "servers" end)"' 2>/dev/null |
  while IFS="$TAB" read -r _wr _wu; do
    _wf="$RUN/zapret/$_wr"
    # first look: assumed on zapret, so a rule that stays on its servers is told
    read -r _wold _wn _wtold 2>/dev/null < "$_wf" || { _wold=$_wu; _wn=0; _wtold=zapret; }
    if [ "$_wu" = "$_wold" ]; then _wn=$((_wn + 1)); else _wn=1; fi
    if [ "$_wn" -ge 2 ] && [ "$_wu" != "$_wtold" ]; then
      _wtold=$_wu
      if [ "$_wu" = servers ]; then event zapret_servers "$(jq -nc --arg s "$_wr" '{section: $s}')"
      else event zapret_direct "$(jq -nc --arg s "$_wr" '{section: $s}')"; fi
    fi
    echo "$_wu $_wn $_wtold" > "$_wf"
  done
}

# zapret_repair <Clash API proxies>: a zapret rule whose outbounds are not
# in the running sing-box (a podkop restart, a reload that could not add
# them) gets them back with a reload in place. Only after two rounds in a row
# (the daemon adds them itself the round after a podkop start), not while
# podkop starts or an apply runs, and after a failed try not again for 5
# minutes. One event when it starts failing, one when it is mended.
zapret_repair() {
  _zm=$(printf '%s' "$1" | jq -r --argjson r "$(zapret_rules_json)" --argjson skip "$(zapret_skip_json)" '
    .proxies as $p | $r | keys[] | select(($skip | index(.)) == null)
    | select($p[. + "-out"] != null and $p[. + "-zapret-out"] == null)' 2>/dev/null | tr '\n' ' ')
  _zm=${_zm% }
  if [ -z "$_zm" ]; then
    [ ! -f "$RUN/zapret/missing" ] || { rm -f "$RUN/zapret/missing" "$RUN/zapret/repair-failed"; }
    return 0
  fi
  _zmn=$(( $(cut -d ' ' -f 1 "$RUN/zapret/missing" 2>/dev/null || echo 0) + 1 ))
  echo "$_zmn" > "$RUN/zapret/missing"
  [ "$_zmn" -ge 2 ] || return 0
  find "$RUN/zapret/repair-failed" -mmin -5 2>/dev/null | grep -q . && return 0
  [ "$(podkop_start_state)" = 0 ] || return 0
  if _zwhy=$( (flock -n 9 || { echo busy; exit 1; }; hot_apply "zapret: outbounds of $_zm were missing in sing-box, added again") 9> "$RUN/apply.lock"); then
    reapply_pins >/dev/null 2>&1
    rm -f "$RUN/zapret/missing" "$RUN/zapret/repair-failed"
    event zapret_repaired "$(jq -nc --arg r "$_zm" '{rules: ($r | split(" "))}')"
  elif [ "$_zwhy" != busy ]; then
    # (told once: the file stays until the outbounds are there again)
    [ -f "$RUN/zapret/repair-failed" ] ||
      event zapret_missing "$(jq -nc --arg r "$_zm" --arg w "$_zwhy" '{rules: ($r | split(" ")), reason: $w}')"
    : > "$RUN/zapret/repair-failed"
    logger -t podkop-agent "zapret: outbounds of $_zm are missing in sing-box and could not be added: $_zwhy"
  fi
}

# zapret_prune: a rule whose section is gone or is no proxy rule any more
# (removed, renamed, made a VPN or direct rule) leaves zapret; otherwise it
# would stay in the list and every later change of the list be refused
zapret_prune() {
  _zs=$(seen_json) || return 0
  printf '%s' "$_zs" | jq -e 'any(.sections[]; .name == "settings")' >/dev/null 2>&1 || return 0
  _zgone=$(printf '%s' "$_zs" | jq -r --argjson r "$(zapret_rules_json)" '
    [.sections[] | select(.type == "section" and (.options.connection_type // "") == "proxy") | .name] as $ok
    | $r | keys - $ok | join(" ")')
  [ -n "$_zgone" ] || return 0
  ( flock -n 9 || exit 0
    jq -c --arg g "$_zgone" 'with_entries(select(.key as $k | ($g | split(" ") | index($k)) == null))' "$ZAPRET_RULES" > "$RUN/zapret.rules" || exit 0
    if [ "$(cat "$RUN/zapret.rules")" = '{}' ]; then
      rm -f "$ZAPRET_RULES" "$RUN/zapret.rules"
      [ -z "$(singbox_pid)" ] || hot_apply "zapret: $_zgone left (no proxy rule any more)" >/dev/null
      [ ! -x "$ZAPRET_INIT" ] || "$ZAPRET_INIT" stop >/dev/null 2>&1 7>&- 8>&- 9>&-
      zapret_nft off
    else
      cp "$RUN/zapret.rules" "$ZAPRET_RULES.t" && mv "$ZAPRET_RULES.t" "$ZAPRET_RULES"; rm -f "$RUN/zapret.rules"
      "$ZAPRET_INIT" restart >/dev/null 2>&1 7>&- 8>&- 9>&-
      zapret_table || zapret_nft
      [ -z "$(singbox_pid)" ] || hot_apply "zapret: $_zgone left (no proxy rule any more)" >/dev/null
    fi
    logger -t podkop-agent "zapret: $_zgone left zapret (the rule is gone or no proxy rule)"
    event zapret_dropped "$(jq -nc --arg r "$_zgone" '{rules: ($r | split(" "))}')"
  ) 9> "$RUN/apply.lock"
}

# zapret_state <file with {tag: now}>: each rule's state as the pages show it:
# zapret | servers (its check fails, the rule's servers carry it) | missing
# (not in sing-box) | stopped (nfqws2 does not run) | no_table | no_rule |
# refused (kill switch or Protected) | not_installed | unknown (no Clash API)
zapret_state() {
  if [ ! -s "$ZAPRET_RULES" ]; then echo '{}'; return; fi
  jq -c --slurpfile now "$1" --argjson skip "$(zapret_skip_json)" --argjson run "$(zapret_running)" \
    --arg inst "$(zapret_installed && echo 1)" --arg tbl "$(zapret_table && echo 1)" '
    ($now[0] // null) as $p | with_entries(.key as $k | .value = (
      if ($skip | index($k)) != null then "refused"
      elif $inst != "1" then "not_installed"
      elif ($p | type) != "object" or ($p | length) == 0 then "unknown"
      elif $p[$k + "-out"] == null then "no_rule"
      elif $tbl != "1" then "no_table"
      elif ($run | index($k)) == null then "stopped"
      elif $p[$k + "-zapret-out"] == null then "missing"
      elif ($p[$k + "-zapret-out"] | endswith("-zapret-direct")) then "zapret"
      else "servers" end))' "$ZAPRET_RULES"
}

zapret_status() {
  _zp=$(proxies 2>/dev/null); [ -n "$_zp" ] || _zp=null
  printf '%s' "$_zp" | jq -c '(.proxies // {}) | map_values(.now // "")' > "$RUN/zapret-now.$$" 2>/dev/null || echo '{}' > "$RUN/zapret-now.$$"
  _zst=$(zapret_state "$RUN/zapret-now.$$"); rm -f "$RUN/zapret-now.$$"; [ -n "$_zst" ] || _zst='{}'
  jq -nc --argjson r "$(zapret_rules_json)" --arg arch "$(uname -m)" --argjson state "$_zst" \
    --argjson ver "$(cat "$ZAPRET_DIR/version.json" 2>/dev/null || echo '{}')" \
    --arg e2 "$([ -x "$ZAPRET_DIR/nfqws2" ] && echo 1)" \
    --arg tbl "$(zapret_table && echo 1)" --argjson run "$(zapret_running)" --argjson px "$_zp" \
    --argjson skip "$(zapret_skip_json)" --argjson iv "$(zapret_interval)" \
    --arg q "$(lsmod 2>/dev/null | grep -c '^nft_queue ')" \
    '{arch: $arch, installed: (if $e2 == "1" then ($ver.nfqws2 // "") else null end),
      queue: ($q != "0"), table: ($tbl == "1"), rules: $r, running: $run, refused: $skip, interval: $iv, state: $state,
      using: ($r | with_entries(.value = (($px.proxies[.key + "-zapret-out"].now? // null)
               | if . == null then null elif endswith("-zapret-direct") then "zapret" else "servers" end)))}'
}

# zapret_fetch <config> <url> <seconds> -> "ok <ms> <bytes>" | "fail <ms> <reason>"
zapret_fetch() {
  _f0=$(cut -d ' ' -f 1 /proc/uptime | tr -d .)
  sing-box tools fetch -c "$1" "$2" > "$1.body" 2> "$1.err" &
  _fp=$!; _fw=0
  while kill -0 "$_fp" 2>/dev/null && [ "$_fw" -lt "$(( $3 * 4 ))" ]; do sleep 0.25; _fw=$((_fw + 1)); done
  if kill "$_fp" 2>/dev/null; then wait "$_fp" 2>/dev/null; _fr=124; else wait "$_fp" 2>/dev/null; _fr=$?; fi
  _fms=$(( ($(cut -d ' ' -f 1 /proc/uptime | tr -d .) - _f0) * 10 ))
  if [ "$_fr" = 0 ]; then echo "ok $_fms $(wc -c < "$1.body")"
  elif [ "$_fr" = 124 ]; then echo "fail $_fms no answer in $3 s"
  else echo "fail $_fms $(tail -n 1 "$1.err" | sed 's/\x1b\[[0-9;]*m//g; s/^FATAL\[[0-9]*\] //' | cut -c 1-200)"; fi
  rm -f "$1.body" "$1.err"
}

# zapret_test_end: the search's nfqws2 (queue 399) is gone, whoever started it
zapret_test_end() {
  for _p in /proc/[0-9]*; do
    case "$(tr '\0' ' ' < "$_p/cmdline" 2>/dev/null)" in
      *"/nfqws2 --qnum=$((300 + ZAPRET_TEST)) "*) kill "${_p#/proc/}" 2>/dev/null ;;
    esac
  done
}

# the strategy search; input in jobs/<id>.in: {"urls": [...], "strategies":
# [{"name", "args"}], "timeout": s, "want": n}. Each URL without zapret
# first (one that opens bare proves nothing), then each strategy with a fresh
# nfqws2 on the test queue until "want" of them opened every URL
run_zapret_check() {
  _id=$1; _ji="$RUN/jobs/$_id.in"; _jc="$RUN/zapret-check.$$"
  exec 7> "$RUN/zapret-check.lock"
  flock -n 7 || { job_end "$_id" failed "another strategy search is running"; return; }
  job_set "$_id" '.state = "running" | .baseline = [] | .results = []'
  _to=$(jq -r '.timeout // 8' "$_ji"); _want=$(jq -r '.want // 3' "$_ji")
  _bd=$(uci -q get podkop.settings.bootstrap_dns_server)
  jq -nc --arg d "${_bd:-77.88.8.8}" --argjson m "$((ZAPRET_BASE + ZAPRET_TEST))" '{log: {disabled: true},
    dns: {servers: [{type: "udp", tag: "d", server: $d}]},
    outbounds: [{type: "direct", tag: "z", routing_mark: $m, domain_resolver: "d"}],
    route: {final: "z", default_domain_resolver: "d"}}' > "$_jc.json"
  _own=0; zapret_table || { zapret_nft && _own=1; } || { job_end "$_id" failed "could not add the firewall table"; return; }
  _zpid=""
  trap 'kill "$_zpid" 2>/dev/null; zapret_test_end; [ "$_own" = 1 ] && [ ! -s "$ZAPRET_RULES" ] && zapret_nft off; rm -f "$_jc".*' EXIT
  trap 'exit 1' TERM INT
  jq -r '.urls[]' "$_ji" > "$_jc.urls"
  while IFS= read -r _u; do
    # shellcheck disable=SC2046   # "ok|fail <ms> <words>"
    set -- $(zapret_fetch "$_jc.json" "$_u" "$_to")
    job_set "$_id" '.baseline += [{url: $u, ok: ($r == "ok"), ms: ($ms | tonumber), detail: $d}]' \
      --arg u "$_u" --arg r "$1" --arg ms "$2" --arg d "$(shift 2; echo "$*")"
  done < "$_jc.urls"
  _n=$(jq '.strategies | length' "$_ji"); _i=0; _good=0
  while [ "$_i" -lt "$_n" ] && [ "$_good" -lt "$_want" ]; do
    jq -c --argjson i "$_i" '.strategies[$i]' "$_ji" > "$_jc.s"; _i=$((_i + 1))
    job_set "$_id" '.trying = $s' --argjson s "$(cat "$_jc.s")"
    jq -c --argjson t "$ZAPRET_TEST" '. + {n: $t}' "$_jc.s" > "$_jc.r"
    ( zapret_exec "$(cat "$_jc.r")" ) > "$_jc.log" 2>&1 7>&- &
    _zpid=$!; sleep 1
    if ! kill -0 "$_zpid" 2>/dev/null; then
      job_set "$_id" '.results += [$s + {ok: false, error: $e, urls: []}]' --argjson s "$(cat "$_jc.s")" \
        --arg e "$( { grep -iE 'error|invalid|unknown|bad |cannot|could not|check ' "$_jc.log"; grep -v '^$' "$_jc.log" | tail -n 1; } | head -n 1 | cut -c 1-200)"
      continue
    fi
    _ok=true; : > "$_jc.res"
    while IFS= read -r _u; do
      # shellcheck disable=SC2046
      set -- $(zapret_fetch "$_jc.json" "$_u" "$_to")
      jq -nc --arg u "$_u" --arg r "$1" --arg ms "$2" --arg d "$(shift 2; echo "$*")" \
        '{url: $u, ok: ($r == "ok"), ms: ($ms | tonumber), detail: $d}' >> "$_jc.res"
      [ "$1" = ok ] || { _ok=false; break; }
    done < "$_jc.urls"
    kill "$_zpid" 2>/dev/null; wait "$_zpid" 2>/dev/null; _zpid=""; zapret_test_end
    [ "$_ok" = true ] && _good=$((_good + 1))
    job_set "$_id" '.results += [$s + {ok: $ok, urls: $u}]' --argjson s "$(cat "$_jc.s")" \
      --argjson ok "$_ok" --argjson u "$(jq -sc . "$_jc.res")"
  done
  job_set "$_id" 'del(.trying)'
  job_end "$_id" "done" "$_good working of $_i tried"
}

# install: stdin {"files": {"nfqws2"|"lua/<name>"|"fake/<name>": base64},
# "version": {"nfqws2": "v1.0.7"}}; files that differ are written (flash),
# nfqws2 must start. -> status
zapret_install() {
  _zi="$RUN/zapret-in.$$"; head -c 8388608 > "$_zi"
  jq -e '(.files | type == "object" and length > 0 and all(keys[];
      . == "nfqws2" or ((startswith("lua/") or startswith("fake/"))
        and (.[(index("/") + 1):] | length > 0 and (startswith(".") | not) and (explode | all(. == 45 or . == 46 or . == 95 or (. >= 48 and . <= 57) or (. >= 65 and . <= 90) or (. >= 97 and . <= 122)))))))
      and ((.version // {}) | type == "object")' "$_zi" >/dev/null 2>&1 ||
    { rm -f "$_zi"; fail bad_request 'expected {"files": {"nfqws2": base64, "lua/<file>": base64, ...}, "version": {...}}'; }
  mkdir -p "$ZAPRET_DIR/lua" "$ZAPRET_DIR/fake" "$RUN/zapret-new"
  for _zk in $(jq -r '.files | keys[]' "$_zi"); do
    jq -j --arg k "$_zk" '.files[$k]' "$_zi" | base64 -d > "$RUN/zapret-new/x" 2>/dev/null ||
      { rm -rf "$_zi" "$RUN/zapret-new"; fail bad_request "$_zk is not base64"; }
    case "$_zk" in nfqws2)
      chmod 755 "$RUN/zapret-new/x"
      "$RUN/zapret-new/x" --version >/dev/null 2>&1 || "$RUN/zapret-new/x" --help 2>&1 | grep -q qnum ||
        { rm -rf "$_zi" "$RUN/zapret-new"; fail bad_request "nfqws2 does not run on this router ($(uname -m))"; } ;;
    esac
    if ! cmp -s "$RUN/zapret-new/x" "$ZAPRET_DIR/$_zk"; then
      { cp "$RUN/zapret-new/x" "$ZAPRET_DIR/$_zk.t" && mv "$ZAPRET_DIR/$_zk.t" "$ZAPRET_DIR/$_zk"; } ||
        { rm -rf "$_zi" "$RUN/zapret-new"; fail error "could not write $_zk"; }
    fi
  done
  # nfqws2 drops its privileges after the start: what it reads later must be readable
  chmod 755 "$ZAPRET_DIR" "$ZAPRET_DIR/lua" "$ZAPRET_DIR/fake"; chmod -R a+rX "$ZAPRET_DIR"
  jq -c '.version // {}' "$_zi" > "$RUN/zapret-new/v"
  cmp -s "$RUN/zapret-new/v" "$ZAPRET_DIR/version.json" || cp "$RUN/zapret-new/v" "$ZAPRET_DIR/version.json"
  rm -rf "$_zi" "$RUN/zapret-new"
  zapret_init || fail error "could not write $ZAPRET_INIT"
  [ ! -s "$ZAPRET_RULES" ] || "$ZAPRET_INIT" restart >/dev/null 2>&1 7>&- 8>&- 9>&-
  event zapret_installed "$(jq -c . "$ZAPRET_DIR/version.json")"
  reply "$(zapret_status)"
}

# set: stdin {"rules": {"<rule>": {"args", "url", "name", "service"}}, "interval": s} (all of them;
# {} turns zapret off); a rule keeps its number, so its mark and queue
zapret_set() {
  _zq=$(head -c 262144)
  printf '%s' "$_zq" | jq -e --argjson deny "$ZAPRET_DENY" '(.interval // 30) as $iv | .rules | type == "object" and length <= 50 and all(to_entries[];
      (.key | length > 0 and length <= 64 and (explode | all(. == 95 or (. >= 48 and . <= 57) or (. >= 65 and . <= 90) or (. >= 97 and . <= 122))))
      and ((.value.name // "") | type == "string" and length <= 120 and (contains("\n") | not))
      and ((.value.service // "") | type == "string" and length <= 32 and (explode | all(. == 95 or (. >= 48 and . <= 57) or (. >= 97 and . <= 122))))
      and (.value.args | '"$ZAPRET_ARGS_OK"')
      and (.value.url | type == "string" and (startswith("https://") or startswith("http://")) and length <= 300
           and (explode | all(. >= 33 and . <= 126))))
      and ($iv | type == "number" and . >= 15 and . <= 600 and . % 15 == 0)' >/dev/null 2>&1 ||
    fail bad_request 'expected {"rules": {"<rule>": {"args": ["--..."], "url": "https://...", "name"}}, "interval": 15..600 by 15}'
  _zn=$(printf '%s' "$_zq" | jq -c '.rules | with_entries(.value |= {args, url, name: (.name // ""), service: (.service // "")})')
  if [ "$_zn" != '{}' ]; then
    ! safe_mode || fail safe_mode "safe mode: the router runs plain podkop; leave safe mode first"
    zapret_installed || fail not_installed "zapret2 is not installed on the router"
    # only what this request adds or changes is checked: a rule that is on
    # already and has since got a kill switch stays (left out of sing-box
    # until it is turned off), and one whose section is gone leaves quietly,
    # so one stale rule never blocks the changes of the others
    _zs=$(seen_json) || fail error "could not read podkop's settings"
    _bad=$(printf '%s' "$_zs" | jq -r --argjson z "$_zn" --argjson old "$(zapret_rules_json)" --argjson skip "$(zapret_skip_json)" '
      [.sections[] | select(.type == "section") | {key: .name, value: .options}] | from_entries as $s
      | $z | keys[] | . as $k | select($old[$k] == null or ($old[$k] | del(.n)) != $z[$k])
      | select(($s[$k] == null) or (($s[$k].connection_type // "") != "proxy") or ($skip | index($k)))' | head -n 1)
    [ -z "$_bad" ] || fail bad_request "$_bad: zapret works only on proxy rules without kill switch or protection"
    _zn=$(printf '%s' "$_zs" | jq -c --argjson z "$_zn" '
      [.sections[] | select(.type == "section" and (.options.connection_type // "") == "proxy") | .name] as $ok
      | $z | with_entries(select(.key as $k | ($ok | index($k)) != null))')
  fi
  # numbers: kept for rules that stay, the smallest free one for new ones
  _zn=$(jq -nc --argjson new "$_zn" --argjson old "$(zapret_rules_json)" --argjson t "$ZAPRET_TEST" '
    reduce ($new | keys[]) as $k ({};
      ([.[] | .n] + [$new | keys[] | $old[.].n // empty]) as $used
      | . + {($k): ($new[$k] + {n: ($old[$k].n // ([range(1; $t)] - $used | first))})})')
  mkdir -p "$ZAPRET_DIR"
  # the check interval: written (flash) only when it changes; sing-box takes it at once
  _ziv=$(printf '%s' "$_zq" | jq -r '.interval // empty')
  _zivc=0
  if [ -n "$_ziv" ] && [ "$_ziv" != "$(zapret_interval)" ]; then
    { echo "$_ziv" > "$ZAPRET_INTERVAL.t" && mv "$ZAPRET_INTERVAL.t" "$ZAPRET_INTERVAL"; } || fail error "could not write the check interval"
    _zivc=1
  fi
  printf '%s\n' "$_zn" | jq -cS . > "$RUN/zapret.rules"
  if cmp -s "$RUN/zapret.rules" "$ZAPRET_RULES" || { [ "$_zn" = '{}' ] && [ ! -e "$ZAPRET_RULES" ]; }; then
    rm -f "$RUN/zapret.rules"
    if [ "$_zivc" = 1 ] && [ "$_zn" != '{}' ] && [ -n "$(singbox_pid)" ]; then
      exec 9> "$RUN/apply.lock"; flock -n 9 || fail busy "an apply is in progress"
      _zh=$(hot_apply "zapret check interval: $_ziv s") || { exec 9>&-; fail recovery_failed "sing-box did not take the change: $_zh"; }
      exec 9>&-
    fi
    reply "$(zapret_status)"
  fi
  exec 9> "$RUN/apply.lock"; flock -n 9 || { rm -f "$RUN/zapret.rules"; fail busy "an apply is in progress"; }
  if [ "$_zn" = '{}' ]; then
    # sing-box first: its zapret outbounds must be gone before the table is
    rm -f "$ZAPRET_RULES" "$RUN/zapret.rules"
    if [ -n "$(singbox_pid)" ]; then _zh=$(hot_apply "zapret turned off") || { exec 9>&-; fail recovery_failed "sing-box did not take the change: $_zh"; }; fi
    [ ! -x "$ZAPRET_INIT" ] || "$ZAPRET_INIT" stop >/dev/null 2>&1 7>&- 8>&- 9>&-
    zapret_nft off
  else
    { cp "$RUN/zapret.rules" "$ZAPRET_RULES.t" && mv "$ZAPRET_RULES.t" "$ZAPRET_RULES"; } || { exec 9>&-; fail error "could not write the rules"; }
    rm -f "$RUN/zapret.rules"
    zapret_init || { exec 9>&-; fail error "could not write $ZAPRET_INIT"; }
    # the table and nfqws2 first, then sing-box sends to them
    "$ZAPRET_INIT" restart >/dev/null 2>&1 7>&- 8>&- 9>&-
    zapret_table || zapret_nft || { exec 9>&-; fail error "could not add the firewall table (kmod-nft-queue missing?)"; }
    if [ -n "$(singbox_pid)" ]; then _zh=$(hot_apply "zapret rules changed") || { exec 9>&-; fail recovery_failed "sing-box did not take the change: $_zh"; }; fi
  fi
  exec 9>&-
  event zapret "$(jq -nc --argjson r "$(zapret_rules_json)" '{rules: ($r | keys)}')"
  reply "$(zapret_status)"
}

# zapret status | install | set | check (job) | uninstall
cmd_zapret() {
  case "${1:-status}" in
    status) reply "$(zapret_status)" ;;
    install) zapret_install ;;
    set) zapret_set ;;
    check)
      zapret_installed || fail not_installed "zapret2 is not installed on the router"
      mkdir -p "$RUN/jobs"; _zc="$RUN/zapret-check-in.$$"; head -c 262144 > "$_zc"
      jq -e --argjson deny "$ZAPRET_DENY" '(.urls | type == "array" and length > 0 and length <= 10 and all(.[]; type == "string"
          and (startswith("https://") or startswith("http://")) and length <= 300 and (explode | all(. >= 33 and . <= 126))))
        and (.strategies | type == "array" and length > 0 and length <= 200 and all(.[];
          (.args | '"$ZAPRET_ARGS_OK"') and ((.name // "") | type == "string" and length <= 120)))
        and ((.timeout // 8) | type == "number" and . >= 2 and . <= 30) and ((.want // 3) | type == "number" and . >= 1)' "$_zc" >/dev/null 2>&1 ||
        { rm -f "$_zc"; fail bad_request 'expected {"urls": [...], "strategies": [{"name", "args"}], "timeout", "want"}'; }
      _id=$(job_new zapret-check); mv "$_zc" "$RUN/jobs/$_id.in"; spawn _run-zapret-check "$_id"
      reply "$(jq -nc --arg id "$_id" '{job: $id}')" ;;
    uninstall)
      [ ! -s "$ZAPRET_RULES" ] || fail bad_request "turn zapret off on every rule first"
      [ ! -x "$ZAPRET_INIT" ] || { "$ZAPRET_INIT" disable; "$ZAPRET_INIT" stop >/dev/null 2>&1 7>&- 8>&- 9>&-; }
      zapret_nft off; rm -rf "$ZAPRET_DIR" "$ZAPRET_INIT"
      event zapret_removed
      reply "$(zapret_status)" ;;
    diag)
      # for the support report: the firewall table with its counters, what
      # the running sing-box has of zapret, and the log lines about it
      _zcp=$(uci -q get podkop.settings.config_path)
      _zsb=$(jq -c '{outbounds: [.outbounds[]? | select((.tag // "") | endswith("-zapret-out") or endswith("-zapret-direct"))
          | {tag, type, outbounds, fallbacks, url, interval, routing_mark}],
        route_rules: [.route.rules[]? | select((.outbound // "") | endswith("-zapret-out"))
          | {outbound, network, port, protocol}]}' "$_zcp" 2>/dev/null)
      reply "$(jq -nc --argjson st "$(zapret_status)" --arg t "$(nft list table inet podkop_zapret 2>/dev/null)" \
        --argjson sb "${_zsb:-null}" \
        --arg log "$(logread 2>/dev/null | grep -E 'nfqws2|podkop-zapret|zapret' | tail -n 100)" \
        '{status: $st, table: $t, singbox: $sb, log: ($log | split("\n") | map(select(. != "")))}')" ;;
    *) fail bad_request "usage: zapret status|install|set|check|uninstall|diag" ;;
  esac
}

# --- commands ---------------------------------------------------------------------

cmd_status() {
  _fp=$(seen_fp)
  _st=$(podkop_start_state)
  _probe=$(cat "$RUN/probe/state" 2>/dev/null || echo none)
  _pins='[]'
  [ -s "$ETC/pins" ] && _pins=$(while IFS="$TAB" read -r _s _h; do
            jq -nc --arg s "$_s" --arg t "$(link_tag "$_s" "$_h")" '{section: $s, server: $t}'
          done < "$ETC/pins" | jq -sc '.')
  _pid=$(singbox_pid)
  # the groups and servers come along, so the manager needs one call per look
  _px=null; [ -z "$_pid" ] || _px=$(proxies_json) || _px=null
  printf '%s' "${_px:-null}" > "$RUN/status.$$.px"      # in a file: too long for one argument with many servers
  _zst='{}'
  if [ -s "$ZAPRET_RULES" ]; then
    jq -c '[(.groups // [])[] | {(.name): (.now // "")}] + [(.servers // [])[] | {(.name): ""}] | add // {}' \
      "$RUN/status.$$.px" > "$RUN/status.$$.now" 2>/dev/null || echo '{}' > "$RUN/status.$$.now"
    _zst=$(zapret_state "$RUN/status.$$.now"); rm -f "$RUN/status.$$.now"; [ -n "$_zst" ] || _zst='{}'
  fi
  _sr=$(jq -nc --arg av "$AGENT_VERSION" --argjson pv "$PROTO" --argjson caps "$(capabilities)" --arg boot "$BOOT" \
    --arg up "$(cut -d ' ' -f 1 /proc/uptime | cut -d . -f 1)" \
    --argjson fixed "$(static_json)" \
    --arg en "$(podkop_enabled && echo 1 || echo 0)" --arg pa "$([ -f "$ETC/paused" ] && echo 1 || echo 0)" \
    --arg st "$_st" --arg pid "$_pid" \
    --arg fp "$_fp" --arg lg "$(cat "$ETC/last-good.fp" 2>/dev/null)" \
    --arg busy "$(flock -n "$RUN/apply.lock" true 2>/dev/null && echo 0 || echo 1)" \
    --arg probe "$_probe" --argjson pins "${_pins:-[]}" \
    --arg fs "$(tail -n 1 /etc/sing-box/failsafe.last 2>/dev/null)" --arg fst "$(head -n 1 /etc/sing-box/failsafe.last 2>/dev/null)" \
    --arg pcron "$(probe_cron)" --arg tz "$(date +%z)" \
    --arg mem "$(awk '/^MemAvailable:/ { print int($2 / 1024) }' /proc/meminfo 2>/dev/null)" \
    --argjson heal "$(if command -v heal_status >/dev/null 2>&1; then heal_status; else echo null; fi)" \
    --slurpfile px "$RUN/status.$$.px" --argjson v6 "$(ipv6_json)" --argjson dns "$(dns_json)" \
    --arg now "$(date +%s)" --arg clk "$(clock_ok && echo 1 || echo 0)" --argjson zst "$_zst" \
    --argjson safe "$(safe_json)" --argjson prot "$(protected_json)" --argjson sent "$(sentinel_json)" \
    --arg beat "$(_b=$(date -r "$RUN/beat" +%s 2>/dev/null) && echo $(( $(date +%s) - _b )))" \
    --arg fdn "$([ -z "$_pid" ] || ls "/proc/$_pid/fd" 2>/dev/null | wc -l)" \
    --arg fdm "$([ -z "$_pid" ] || awk '/^Max open files/ { print $4 }' "/proc/$_pid/limits" 2>/dev/null)" \
    '{agent: {version: $av, protocol: $pv, capabilities: $caps}, boot: $boot, uptime: ($up | tonumber? // 0),
      time: ($now | tonumber? // null), clock_set: ($clk == "1"), dns: $dns,
      router: {model: $fixed.model, openwrt: $fixed.os, utc_offset: $tz, mem_free: ($mem | tonumber? // null)},
      podkop: {version: $fixed.podkop, enabled: ($en == "1"), paused: ($pa == "1"), start: $st,
               running: ($pid != ""), busy: ($busy == "1")},
      singbox: {version: $fixed.singbox, features: $fixed.features,
                fds: (if ($fdn | tonumber? // 0) > 0 then {open: ($fdn | tonumber), limit: ($fdm | tonumber? // null)} else null end)},
      fingerprint: $fp, last_good: $lg, pins: $pins, probe: {state: $probe, version: $fixed.probe, cron: $pcron},
      engine: $fixed.engine, heal: $heal, proxies: $px[0], ipv6: $v6, zapret: $zst,
      daemon: {beat: ($beat | tonumber? // null)}, safe_mode: $safe, protected: $prot, sentinel: $sent,
      failsafe: (if $fs == "" then null else {time: $fst, message: $fs} end)}')
  rm -f "$RUN/status.$$.px"
  reply "$_sr"
}

cmd_config_get() {
  _c=$(config_json) || fail podkop "cannot read podkop's settings"
  _svc=$(community_lists)
  _ifs=$(ubus call network.interface dump 2>/dev/null | jq -c '[.interface[]?.interface]')
  _devs=$(ubus call network.device status 2>/dev/null | jq -c 'keys')
  reply "$(printf '%s' "$_c" | jq -c --arg fp "$(printf '%s' "$_c" | fingerprint)" --arg svc "$_svc" \
    --argjson ifs "${_ifs:-[]}" --argjson devs "${_devs:-[]}" \
    '{fingerprint: $fp, config: ., community_lists: ($svc | split(" ") | map(select(. != ""))),
      interfaces: $ifs, devices: $devs}')"
}

cmd_apply() {
  _id=$(job_new apply)
  cat > "$RUN/jobs/$_id.in"
  jq -e '.config.sections | type == "array"' "$RUN/jobs/$_id.in" >/dev/null 2>&1 || {
    job_end "$_id" rejected "expected {\"base\": ..., \"config\": {\"sections\": [...]}}"
    fail bad_request "expected {\"base\": ..., \"config\": {\"sections\": [...]}}"
  }
  spawn _run-apply "$_id"
  reply "$(jq -nc --arg id "$_id" '{job: $id}')"
}

# job <id> [wait seconds]
cmd_job() {
  case "${1:-}" in ""|*[!0-9-]*) fail bad_request "job id expected" ;; esac
  _jf=$(job_file "$1"); [ -f "$_jf" ] || fail not_found "no job $1"
  _w=0; _max=${2:-0}
  case "$_max" in *[!0-9]*) _max=0 ;; esac
  while [ "$_w" -lt "$_max" ]; do
    case "$(jq -r .state "$_jf")" in queued|checking|reloading|restarting|reverting|running) ;; *) break ;; esac
    sleep 1; _w=$((_w + 1))
  done
  reply "$(cat "$_jf")"
}

# validate: the checks of "apply" without changing anything
cmd_validate() {
  _vf="$RUN/validate.$$.json"
  cat | jq -c ".config | $NORM" > "$_vf" 2>/dev/null || { rm -f "$_vf"; fail bad_request "expected {\"config\": {...}}"; }
  _bad=$(check_names "$_vf")
  [ -z "$_bad" ] || { rm -f "$_vf"; fail bad_request "\"$_bad\" is not a valid name"; }
  _p=$(validate "$_vf"); rm -f "$_vf"
  reply "$(jq -nc --argjson p "$_p" '{problems: $p}')"
}

# pin <section> <tag|auto>
cmd_pin() {
  _s=${1:-}; _t=${2:-}
  case "$_s" in ""|*[!A-Za-z0-9_]*) fail bad_request "section name expected" ;; esac
  _pt=$(config_json | jq -r --arg s "$_s" '.sections[] | select(.name == $s) | .options.proxy_config_type // ""')
  case "$_pt" in selector|urltest) ;; *) fail bad_request "section $_s has no server choice (needs selector or urltest)" ;; esac
  exec 6> "$RUN/pins.lock"; flock 6
  # the pins file changes only after the switch worked (a wrong tag or a
  # silent Clash API must not lose the pin there was), in one write
  _l=""
  if [ "$_t" = auto ]; then
    [ "$_pt" = urltest ] && { select_server "$_s" "$_s-urltest-out" || fail clash "could not switch $_s-out"; }
  else
    case "$_t" in ""|*[!A-Za-z0-9_-]*) fail bad_request "server tag expected, like $_s-2-out, or auto" ;; esac
    _l=$(tag_link "$_s" "$_t"); [ -n "$_l" ] || fail not_found "section $_s has no server $_t"
    select_server "$_s" "$_t" || fail clash "could not switch $_s-out to $_t (is podkop running?)"
  fi
  grep -v "^$_s$TAB" "$ETC/pins" > "$RUN/pins.t" 2>/dev/null
  [ -z "$_l" ] || printf '%s\t%s\n' "$_s" "$(link_md5 "$_l")" >> "$RUN/pins.t"
  if ! cmp -s "$RUN/pins.t" "$ETC/pins" && { [ -s "$RUN/pins.t" ] || [ -e "$ETC/pins" ]; }; then
    cp "$RUN/pins.t" "$ETC/pins.t" && mv "$ETC/pins.t" "$ETC/pins"
  fi
  rm -f "$RUN/pins.t"
  if [ "$_t" = auto ]; then
    event pin_cleared "$(jq -nc --arg s "$_s" '{section: $s}')"
    reply "$(jq -nc --arg s "$_s" '{section: $s, server: "auto"}')"
  fi
  event pinned "$(jq -nc --arg s "$_s" --arg t "$_t" '{section: $s, server: $t}')"
  reply "$(jq -nc --arg s "$_s" --arg t "$_t" '{section: $s, server: $t}')"
}

# proxies: groups with their choice and members, and the last delay of every server
cmd_proxies() {
  _p=$(proxies_json) || fail podkop_down "the Clash API does not answer (is podkop running?)"
  reply "$_p"
}

# exit-ips: "exit-ip" for several sections at once (stdin {"sections": [...]}),
# four lookups at a time -> {section: its exit-ip answer, or {section, error}}
cmd_exit_ips() {
  _d=$(mktemp -d "$RUN/exits.XXXXXX") || fail error "cannot create exits directory"
  head -c 65536 > "$_d/in"
  jq -e '.sections | type == "array" and length <= 64 and all(type == "string")' \
    "$_d/in" >/dev/null 2>&1 || { rm -rf "$_d"; fail bad_request "expected {\"sections\": [...]}"; }
  _n=0
  for _s in $(jq -r '.sections[]' "$_d/in"); do
    case "$_s" in *[!A-Za-z0-9_]*) continue ;; esac
    ( cmd_exit_ip "$_s" ) > "$_d/$_s.json" 2>/dev/null &
    # two at a time: each lookup is a sing-box of its own (memory)
    _n=$((_n + 1)); [ $((_n % 2)) = 0 ] && wait
  done
  wait
  # (reply exits: the folder goes first)
  _r=$(for _f in "$_d"/*.json; do [ -f "$_f" ] || continue
    _s=$(basename "$_f" .json)
    jq -c --arg s "$_s" 'if .ok == true then .data else {section: $s, error: (.error.message // "no answer")} end' "$_f" 2>/dev/null ||
      jq -nc --arg s "$_s" '{section: $s, error: "no answer"}'
  done | jq -sc 'map({key: .section, value: .}) | from_entries')
  rm -rf "$_d"
  reply "$_r"
}

# exit-ip <section>: where the section's traffic leaves to the internet now:
# through the server it uses (a sing-box run of just that outbound, taken
# from podkop's running config) or, for a VPN section, its interface ->
# {section, server, ip, country, city, org}
cmd_exit_ip() {
  _s=${1:-}
  case "$_s" in ""|*[!A-Za-z0-9_]*) fail bad_request "section name expected" ;; esac
  _o=$(config_json | jq -c --arg s "$_s" '.sections[] | select(.name == $s) | .options')
  [ -n "$_o" ] || fail not_found "no section $_s"
  _t=""
  case "$(printf '%s' "$_o" | jq -r '.connection_type // ""')" in
    proxy)
      _p=$(proxies); [ -n "$_p" ] || fail podkop_down "the Clash API does not answer (is podkop running?)"
      # the group's choice, and the choice of each group behind it (a urltest group, or
      # main-out behind a section's selector of it)
      _t=$(printf '%s' "$_p" | jq -r --arg s "$_s" '.proxies as $p
        | [limit(8; "\($s)-out" | recurse($p[.].now // empty))] | last')
      case "$_t" in ""|*[!A-Za-z0-9_-]*) fail not_found "section $_s has no server now" ;; esac
      _cfg=$(uci -q get podkop.settings.config_path); [ -n "$_cfg" ] || _cfg=/etc/sing-box/config.json
      # the outbound and the ones it goes through (detour); podkop's DNS servers are not there
      jq -c --arg t "$_t" '.outbounds as $all
        | [$t | recurse(. as $x | ($all[] | select(.tag == $x) | .detour) // empty)] as $chain
        | {log: {disabled: true}, dns: {servers: [{type: "local", tag: "local"}]},
           outbounds: [$all[] | select(.tag as $x | $chain | index($x)) | del(.domain_resolver)],
           route: {final: $t, default_domain_resolver: "local"}}
        | if (.outbounds | length) == 0 then error("no outbound") else . end' "$_cfg" > "$RUN/exit.$$.$_s.json" 2>/dev/null ||
        { rm -f "$RUN/exit.$$.$_s.json"; fail not_found "$_t is not in sing-box's config"; }
      sing-box tools fetch -c "$RUN/exit.$$.$_s.json" https://ipinfo.io/json > "$RUN/exit.$$.$_s.out" 2>&1 &
      _fp=$!; _w=0
      while kill -0 "$_fp" 2>/dev/null && [ "$_w" -lt 15 ]; do sleep 1; _w=$((_w + 1)); done
      kill "$_fp" 2>/dev/null; wait "$_fp" 2>/dev/null
      _j=$(cat "$RUN/exit.$$.$_s.out"); rm -f "$RUN/exit.$$.$_s.json" "$RUN/exit.$$.$_s.out" ;;
    vpn)
      _if=$(printf '%s' "$_o" | jq -r '.interface // ""')
      case "$_if" in ""|*[!A-Za-z0-9_.@-]*) fail bad_request "section $_s has no interface" ;; esac
      _t=$_if
      _j=$(curl -s --max-time 15 --interface "$_if" https://ipinfo.io/json 2>/dev/null) ;;
    *) fail bad_request "section $_s does not leave through a server or an interface" ;;
  esac
  printf '%s' "$_j" | jq -e '.ip' >/dev/null 2>&1 ||
    fail exit_unknown "no answer from ipinfo.io through $_t: $(printf '%s' "$_j" | tail -n 1 | tr -d '\033' | sed 's/\[[0-9;]*m//g' | cut -c 1-200)"
  reply "$(printf '%s' "$_j" | jq -c --arg s "$_s" --arg t "$_t" \
    '{section: $s, server: $t, ip: (.ip // ""), country: (.country // ""), city: (.city // ""), org: (.org // "")}')"
}

# delays <section>: test every server of the section now
cmd_delays() {
  case "${1:-}" in ""|*[!A-Za-z0-9_]*) fail bad_request "section name expected" ;; esac
  _d=$(podkop clash_api get_group_latency "$1-out" 10000 2>/dev/null)
  [ -n "$_d" ] || fail podkop_down "the Clash API does not answer"
  reply "$(printf '%s' "$_d" | jq -c '.')"
}

# logs [lines]: podkop, sing-box, podkop-engine and podkop-agent lines
cmd_logs() {
  _n=${1:-200}; case "$_n" in ""|*[!0-9]*) _n=200 ;; esac
  reply "$(logread 2>/dev/null | grep 'podkop\|sing-box' | tail -n "$_n" | jq -Rsc 'split("\n") | map(select(. != ""))')"
}

# watch [since]: events after <since> ("<boot>:<n>"), then new events and log
# lines as they come, one JSON object per line, until stdin closes
cmd_watch() {
  _since=${1:-}; _from=0
  case "$_since" in "$BOOT":*) _from=${_since#*:} ;; esac
  case "$_from" in ""|*[!0-9]*) _from=0 ;; esac
  printf '{"type":"hello","boot":"%s","agent":"%s"}\n' "$BOOT" "$AGENT_VERSION"
  (
    _n=$_from
    _q=""
    while :; do
      # (the events' counter is read without starting anything: awk runs
      # only after an event, not every second)
      _qn=""; [ -f "$RUN/seq" ] && read -r _qn < "$RUN/seq"
      if [ -f "$EVENTS" ] && [ "$_qn" != "$_q" ]; then
        _q=$_qn
        _o=$(awk -v n="$_n" '{ s = $0; sub(/^\{"id":"[^:]*:/, "", s); sub(/".*/, "", s) } s + 0 > n' "$EVENTS")
        if [ -n "$_o" ]; then
          printf '%s\n' "$_o"
          _n=$(printf '%s\n' "$_o" | tail -n 1 | sed 's/^{"id":"[^:]*:\([0-9]*\)".*/\1/')
        fi
      fi
      sleep 1
    done
  ) &
  _p1=$!
  # logread -f does not end when its reader goes away, so remember its pid
  ( logread -f -e 'podkop\|sing-box' 2>/dev/null & echo $! > "$RUN/watch.$$"; wait ) |
    jq -Rc --unbuffered '{type: "log", line: .}' &
  _p2=$!
  # a dropped ssh session ends this shell with a signal, not with EOF
  trap 'kill "$(cat "$RUN/watch.$$" 2>/dev/null)" "$_p1" "$_p2" 2>/dev/null; rm -f "$RUN/watch.$$"; exit 0' HUP TERM INT PIPE
  cat > /dev/null
  kill "$(cat "$RUN/watch.$$" 2>/dev/null)" "$_p1" "$_p2" 2>/dev/null
  rm -f "$RUN/watch.$$"
  exit 0
}

# service <start|stop|restart|enable|disable>; stop pauses the watchdog too
cmd_service() {
  # not in the middle of an apply or a recovery: its health check would fail
  exec 9> "$RUN/apply.lock"
  flock -n 9 || fail busy "podkop's settings are being applied or podkop is being recovered; try again in a minute"
  case "${1:-}" in
    start)   rm -f "$ETC/paused"; /etc/init.d/podkop start >/dev/null 2>&1 9>&- ;;
    stop)    touch "$ETC/paused"; /etc/init.d/podkop stop >/dev/null 2>&1 9>&- ;;
    restart) rm -f "$ETC/paused"; restart_podkop "restart by manager" ;;
    enable)  /etc/init.d/podkop enable ;;
    disable) /etc/init.d/podkop disable ;;
    *) fail bad_request "start, stop, restart, enable or disable" ;;
  esac
  event service "$(jq -nc --arg a "$1" '{action: $a}')"
  reply "$(jq -nc --arg a "$1" '{action: $a}')"
}

# --- podkop-probe -----------------------------------------------------------------

# options passed through to podkop-probe, with the number of values each takes
PROBE_OPTS="-q:0 -F:0 -v:0 --no-speed:0 --no-youtube:0 --no-entry-check:0 --fix-fingerprint:0 -n:1 -c:1 -j:1 -t:1
--countries:1 --top:1 --max-ping:1 --min-speed:1 --speed-jobs:1 --youtube-noads:1 --unlock:1"

# probe_check: a "running" probe whose runner is gone (killed, e.g. out of
# memory, or never started) has failed; call it holding the probe lock (fd 7)
probe_check() {
  [ "$(cat "$RUN/probe/state" 2>/dev/null)" = running ] || return 0
  _pp=$(cat "$RUN/probe/pid" 2>/dev/null)
  if [ -z "$_pp" ]; then
    # the runner writes its pid at once; a minute without it: it never started
    [ -n "$(find "$RUN/probe/started" -mmin -1 2>/dev/null)" ] && return 0
    _why="podkop-agent: the probe did not start (out of memory?)"
  else
    tr '\0' ' ' < "/proc/$_pp/cmdline" 2>/dev/null | grep -q _run-probe && return 0
    _why="podkop-agent: the probe was killed (out of memory?)"
  fi
  echo "$_why" >> "$RUN/probe/log"
  probe_leftovers
  now > "$RUN/probe/finished"
  echo failed > "$RUN/probe/state"
}

# probe_leftovers: a probe killed outright (no time to clean up) leaves its
# sing-box and its /tmp/podkop-probe.<pid> folder; remove those of probes
# that no longer run
probe_leftovers() {
  for _w in /tmp/podkop-probe.[0-9]*; do
    [ -d "$_w" ] || continue
    [ -d "/proc/${_w##*.}" ] && continue
    for _f in "$_w"/pids/*; do
      [ -f "$_f" ] || continue
      _sp=$(cat "$_f"); tr '\0' ' ' < "/proc/$_sp/cmdline" 2>/dev/null | grep -q "$_w/" && kill "$_sp" 2>/dev/null
    done
    rm -rf "$_w"
  done
}

# key_ok <url>: a subscription key is an http(s) address and nothing else
key_ok() { printf '%s' "$1" | grep -qE '^https?://[^[:space:]]+$'; }
link_ok() { printf '%s' "$1" | grep -qE '^(vless|vmess|trojan|ss|hysteria2|hy2|socks4|socks4a|socks5)://[^[:space:]]+$'; }

# probe-start: stdin {"keys": [subscription urls], "options": ["--countries", "europe", ...]}
cmd_probe_start() {
  [ -x "$PROBE" ] || fail no_probe "podkop-probe is not installed"
  mkdir -p "$RUN/probe"
  exec 7> "$RUN/probe.lock"; flock 7
  probe_check
  [ "$(cat "$RUN/probe/state" 2>/dev/null)" = running ] && fail busy "a probe is already running"
  # checked before it replaces the last run's request
  _rq="$RUN/probe/req.$$.json"
  cat > "$_rq"
  jq -e '(.keys | type == "array" and all(type == "string")) and ((.links // []) | type == "array" and all(type == "string"))
         and ((.keys | length) + ((.links // []) | length) > 0)
         and ((.options // []) | type == "array" and all(type == "string"))' \
    "$_rq" >/dev/null 2>&1 || { rm -f "$_rq"; fail bad_request "expected {\"keys\": [...], \"links\": [...], \"options\": [...]}"; }
  _left=0
  set -f
  for _k in $(jq -r '.keys[]' "$_rq"); do key_ok "$_k" || { rm -f "$_rq"; fail bad_request "a key is not an http(s) address"; }; done
  for _k in $(jq -r '.links[]?' "$_rq"); do link_ok "$_k" || { rm -f "$_rq"; fail bad_request "a link is not a server link"; }; done
  for _a in $(jq -r '.options // [] | .[]' "$_rq"); do
    if [ "$_left" -gt 0 ]; then _left=$((_left - 1)); continue; fi
    _k=""
    for _po in $PROBE_OPTS; do [ "${_po%:*}" = "$_a" ] && _k=${_po##*:}; done
    [ -n "$_k" ] || { rm -f "$_rq"; fail bad_request "probe option $_a is not allowed"; }
    _left=$_k
  done
  set +f
  mv "$_rq" "$RUN/probe/req.json"
  # single links (keys of their own) go to the probe as a file of links
  jq -r '.links[]?' "$RUN/probe/req.json" > "$RUN/probe/links.txt"
  echo running > "$RUN/probe/state"
  rm -f "$RUN/probe/result.csv" "$RUN/probe/result.csv.links" "$RUN/probe/result.csv.unlock" "$RUN/probe/exit" "$RUN/probe/pid"
  now > "$RUN/probe/started"
  exec 7>&-   # the runner must not inherit the lock
  if ! spawn _run-probe; then
    echo failed > "$RUN/probe/state"; now > "$RUN/probe/finished"
    fail no_memory "the probe could not be started (out of memory?)"
  fi
  event probe_started
  reply '{"state":"running"}'
}

run_probe() {
  echo $$ > "$RUN/probe/pid"
  set -f
  set --
  for _o in $(jq -r '.options // [] | .[]' "$RUN/probe/req.json"); do set -- "$@" "$_o"; done
  for _k in $(jq -r '.keys[]' "$RUN/probe/req.json"); do set -- "$@" -s "$_k"; done
  [ -s "$RUN/probe/links.txt" ] && set -- "$@" -f "$RUN/probe/links.txt"
  rm -f /tmp/podkop-probe-best.txt /tmp/podkop-probe-fallback.txt /tmp/podkop-probe-youtube.txt \
    /tmp/podkop-probe-youtube-fallback.txt
  # at most 3 hours (the manager waits that long); TERM lets it clean up
  if command -v timeout >/dev/null 2>&1; then
    timeout -s TERM 10800 "$PROBE" --no-apply --no-color -o "$RUN/probe/result.csv" "$@" > "$RUN/probe/log" 2>&1
  else
    "$PROBE" --no-apply --no-color -o "$RUN/probe/result.csv" "$@" > "$RUN/probe/log" 2>&1
  fi
  _rc=$?
  probe_leftovers
  (
    flock 7
    echo "$_rc" > "$RUN/probe/exit"
    now > "$RUN/probe/finished"
    if [ "$_rc" = 0 ]; then echo "done" > "$RUN/probe/state"; else echo failed > "$RUN/probe/state"; fi
  ) 7> "$RUN/probe.lock"
  event probe_done "$(jq -nc --argjson rc "$_rc" '{exit: $rc}')"
}

# sub-info: each key's usage header and links, fetched by podkop-probe the
# way the probe does it, so the provider sees the same device
cmd_sub_info() {
  [ -x "$PROBE" ] || fail no_probe "podkop-probe is not installed"
  _req=$(cat)
  printf '%s' "$_req" | jq -e '.keys | type == "array" and length > 0' >/dev/null 2>&1 || fail bad_request 'expected {"keys": [...]}'
  set -f; set --
  for _k in $(printf '%s' "$_req" | jq -r '.keys[] | strings'); do
    key_ok "$_k" || fail bad_request "a key is not an http(s) address"
    set -- "$@" -s "$_k"
  done
  set +f
  _out=$("$PROBE" --sub-info --no-color "$@" 2>/dev/null)
  printf '%s\n' "$_out" | grep -q '^K' || fail old_probe "podkop-probe can't read key usage: reinstall the agent"
  reply "$(printf '%s\n' "$_out" | jq -Rsc '
    split("\n") | map(select(. != "") | split("\t"))
    | reduce .[] as $r ([]; if $r[0] == "K" then . + [{url: $r[1], usage: ($r[2] // ""), title: ($r[3] // ""), why: ($r[4] // ""), links: []}]
                         elif $r[0] == "L" and length > 0 then .[-1].links += [$r[1:] | join("\t")] else . end)')"
}

# probe-nodes: stdin {"keys": [...], "fix_fingerprint": bool}: every server of
# the keys as {link, outbound} (or {link, why} when podkop can't use it), made
# by podkop-probe with podkop's own parser, for the manager to test them on
# its server through this router
cmd_probe_nodes() {
  [ -x "$PROBE" ] || fail no_probe "podkop-probe is not installed"
  _req=$(cat)
  printf '%s' "$_req" | jq -e '(.keys | type == "array") and ((.links // []) | type == "array")
    and ((.keys | length) + ((.links // []) | length) > 0)' >/dev/null 2>&1 || fail bad_request 'expected {"keys": [...], "links": [...]}'
  set -f; set --
  printf '%s' "$_req" | jq -e '.fix_fingerprint == true' >/dev/null 2>&1 && set -- --fix-fingerprint
  for _k in $(printf '%s' "$_req" | jq -r '.keys[] | strings'); do
    key_ok "$_k" || fail bad_request "a key is not an http(s) address"
    set -- "$@" -s "$_k"
  done
  _o="$RUN/nodes.$$"
  for _k in $(printf '%s' "$_req" | jq -r '.links[]? | strings'); do
    link_ok "$_k" || { rm -f "$_o.links"; fail bad_request "a link is not a server link"; }
    printf '%s\n' "$_k" >> "$_o.links"
  done
  [ -s "$_o.links" ] && set -- "$@" -f "$_o.links"
  set +f
  "$PROBE" --build-nodes --no-color "$@" > "$_o" 2> "$_o.err"; _rc=$?
  rm -f "$_o.links"
  if [ "$_rc" != 0 ]; then
    _why=$(grep -v '^[[:space:]]*$' "$_o.err" | tail -n 2 | tr '\n' ' '); rm -f "$_o" "$_o.err"
    case "$_why" in *"unknown option: --build-nodes"*) fail old_probe "podkop-probe can't build nodes: reinstall the agent" ;; esac
    fail probe "${_why:-podkop-probe failed}"
  fi
  # (OpenWrt's jq has no regular expressions)
  _r=$(jq -Rsc 'split("\n") | map(split("\t") | select(length > 1 and (.[0] | contains("://")) and (.[0] | contains(" ") | not))
    | {link: .[0], ob: (.[1:] | join("\t"))}
    | if (.ob | startswith("!")) then {link, why: .ob[1:]} else {link, outbound: (.ob | fromjson)} end)' "$_o")
  rm -f "$_o" "$_o.err"
  reply "${_r:-[]}"
}

# traffic: bytes per server since the agent started (see traffic_poll)
cmd_traffic() {
  reply "$(jq -c '{since, servers, links: (.links // {})}' "$RUN/traffic/state.json" 2>/dev/null || echo '{"since":"","servers":{},"links":{}}')"
}

lines_json() { if [ -f "$1" ]; then jq -Rsc 'split("\n") | map(select(. != ""))' "$1"; else echo '[]'; fi; }

# the CSV of podkop-probe -o: n,verdict,ok,total,min,median,p90,mbit_s,exit_ip,country,youtube,youtube_ms,"node"
CSV_JQ='split("\n") | .[1:] | map(select(. != "") | split(",") as $f
  | {n: $f[0], verdict: $f[1], ok: $f[2], total: $f[3], min: $f[4], median: $f[5], p90: $f[6],
     mbit: $f[7], exit_ip: $f[8], country: $f[9], youtube: $f[10], youtube_ms: $f[11],
     node: ($f[12:] | join(",") | ltrimstr("\"") | rtrimstr("\"") | split("\"\"") | join("\""))})'

# probe-config: what podkop-probe set up on the router by itself (its keys and
# settings for the nightly run, and its cron line), for the manager to take over
probe_cron() { grep -s 'podkop-probe --cron' /etc/crontabs/root | grep -v '^[[:space:]]*#' | head -n 1; }
cmd_probe_config() {
  [ -f "$PROBE_CONF" ] || reply "$(jq -nc --arg c "$(probe_cron)" '{saved: false, cron: $c}')"
  # its own file, written by podkop-probe as shell assignments
  # shellcheck disable=SC1090
  reply "$( (SUBS=""; COUNTRIES=""; TOP=""; SECTION=""; YOUTUBE=""; YT_NOADS="RU"; YT_SECTION=""; APPLY_TO=""; MAX_PING=""; MIN_SPEED=""
    . "$PROBE_CONF" >/dev/null 2>&1
    jq -nc --arg subs "$SUBS" --arg c "$COUNTRIES" --arg top "$TOP" --arg sec "$SECTION" --arg yt "$YOUTUBE" \
      --arg noads "$YT_NOADS" --arg ysec "$YT_SECTION" --arg to "$APPLY_TO" --arg mp "$MAX_PING" --arg ms "$MIN_SPEED" \
      --arg cron "$(probe_cron)" \
      '{saved: true, keys: ($subs | split("\n") | map(select(. != ""))), countries: $c, top: ($top | tonumber? // 10),
        section: (if $sec == "" then "main" else $sec end), youtube: ($yt != "0"),
        youtube_noads: $noads,
        youtube_section: (if $ysec == "" then "youtube" else $ysec end),
        apply_to: (if $to == "" then "both" else $to end),
        max_ping: ($mp | tonumber? // 700), min_speed: ($ms | tonumber? // 40), cron: $cron}') )"
}

# probe-cron off: the manager runs the nightly probe from now on
cmd_probe_cron() {
  [ "${1:-}" = off ] || fail bad_request "usage: probe-cron off"
  if [ -n "$(probe_cron)" ]; then
    sed -i '/podkop-probe --cron/d' /etc/crontabs/root && /etc/init.d/cron restart >/dev/null 2>&1
    event probe_cron_off '{}'
  fi
  reply '{"cron": ""}'
}

cmd_probe_status() {
  exec 7> "$RUN/probe.lock"; flock 7; probe_check; exec 7>&-
  # rows and log go through files: with a few hundred servers they are too
  # long for one argument (128 KB), and the answer would be empty
  _pf="$RUN/status.$$"
  tail -n 400 "$RUN/probe/log" 2>/dev/null | jq -Rsc 'split("\n") | map(select(. != ""))' > "$_pf.log"
  [ -s "$_pf.log" ] || echo '[]' > "$_pf.log"
  echo '[]' > "$_pf.rows"; [ -s "$RUN/probe/result.csv" ] && jq -Rsc "$CSV_JQ" "$RUN/probe/result.csv" > "$_pf.rows"
  [ -s "$_pf.rows" ] || echo '[]' > "$_pf.rows"
  # the link of each row, from podkop-probe's result.csv.links ("n<TAB>link")
  if [ -s "$RUN/probe/result.csv.links" ]; then
    jq -Rsc --slurpfile rows "$_pf.rows" '
      (split("\n") | map(select(. != "") | split("\t") | {key: .[0], value: (.[1:] | join("\t"))}) | from_entries) as $l
      | $rows[0] | map(. + {link: ($l[.n] // null)})' "$RUN/probe/result.csv.links" > "$_pf.rows.t" && mv "$_pf.rows.t" "$_pf.rows"
  fi
  # what the services of --unlock said through each row's server ("n<TAB>netflix:ok:LT ...")
  if [ -s "$RUN/probe/result.csv.unlock" ]; then
    jq -Rsc --slurpfile rows "$_pf.rows" '
      (split("\n") | map(select(. != "") | split("\t") | {key: .[0], value: (.[1] // "")}) | from_entries) as $u
      | $rows[0] | map(if $u[.n] then . + {unlock: $u[.n]} else . end)' "$RUN/probe/result.csv.unlock" > "$_pf.rows.t" && mv "$_pf.rows.t" "$_pf.rows"
  fi
  _pr=$(jq -nc --arg st "$(cat "$RUN/probe/state" 2>/dev/null || echo none)" \
    --arg s "$(cat "$RUN/probe/started" 2>/dev/null)" --arg f "$(cat "$RUN/probe/finished" 2>/dev/null)" \
    --arg rc "$(cat "$RUN/probe/exit" 2>/dev/null)" --slurpfile log "$_pf.log" --slurpfile rows "$_pf.rows" \
    --argjson main "$(lines_json /tmp/podkop-probe-best.txt)" \
    --argjson mainfb "$(lines_json /tmp/podkop-probe-fallback.txt)" \
    --argjson yt "$(lines_json /tmp/podkop-probe-youtube.txt)" \
    --argjson ytfb "$(lines_json /tmp/podkop-probe-youtube-fallback.txt)" \
    '{state: $st, started: $s, finished: $f, exit: ($rc | tonumber? // null), log: $log[0], rows: $rows[0],
      lists: {main: $main, main_fallback: $mainfb, youtube: $yt, youtube_fallback: $ytfb}}')
  rm -f "$_pf.log" "$_pf.rows" "$_pf.rows.t"
  reply "$_pr"
}

# resolve_host <name>: its IPv4 address from outside DNS servers (the router's
# own DNS may give podkop's fake 198.18.x addresses)
# --- sections for the VPN server ---------------------------------------------------

# The VPN server's own key (authorized_keys: restrict,command="/usr/bin/podkop-agent
# --sections-only") may ask only this: which podkop section the traffic of its
# users went through. The router sees all of it from one address (the core
# router's NAT), so it answers about names and addresses, never about devices.
# sections_learn <connections.json>, from each traffic poll: host -> section and
# real destination -> section from sing-box's connections, and the FakeIP podkop's
# DNS gives each new host. RAM only; the oldest entries go first.
SECTIONS_MAX=4096
SECTIONS_KEEP=$((7 * 86400))
# A name keeps its FakeIP while sing-box keeps its cache file: a boot or a new
# cache file gives the addresses out again. "<boot id>-<inode of the cache>";
# nothing while the file is away (sing-box restarting).
sections_gen() {
  _gc=$(uci -q get podkop.settings.config_path); [ -n "$_gc" ] || _gc=/etc/sing-box/config.json
  _gp=$(jq -r '.experimental.cache_file.path // empty' "$_gc" 2>/dev/null)
  _gi=$(ls -i "${_gp:-/tmp/sing-box/cache.db}" 2>/dev/null | awk '{ print $1; exit }')
  [ -n "$_gi" ] && printf '%s-%s' "$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)" "$_gi"
}
sections_learn() {
  _sd="$RUN/sections"; mkdir -p "$_sd"
  jq -e '.hosts and .dsts' "$_sd/map.json" >/dev/null 2>&1 || echo '{"hosts":{},"dsts":{}}' > "$_sd/map.json"
  _g=$(sections_gen)
  if [ -n "$_g" ] && [ "$(jq -r '.g // ""' "$_sd/map.json")" != "$_g" ]; then
    # new addresses: the FakeIP of every known name is asked again below
    jq -c --arg g "$_g" '.g = $g | .hosts |= with_entries(.value |= del(.f))' "$_sd/map.json" > "$_sd/map.new" &&
      mv "$_sd/map.new" "$_sd/map.json"
  fi
  _t=$(date +%s)
  jq -c --argjson t "$_t" --argjson max "$SECTIONS_MAX" --argjson keep "$SECTIONS_KEEP" --slurpfile m "$_sd/map.json" '
    # (no regular expressions: the jq of OpenWrt is built without them)
    # a zapret rule sends its web traffic to "<rule>-zapret-out" (names have no "-")
    def sec: (.chains // []) | (last // "") | rtrimstr("-out") | rtrimstr("-zapret");
    def fake: startswith("198.18.") or startswith("198.19.");
    def trim: with_entries(select(.value.t > $t - $keep)) | to_entries | sort_by(-.value.t) | .[:$max] | from_entries;
    $m[0] as $m
    | [.connections[]? | {h: (.metadata.host // ""), d: (.metadata.destinationIP // ""), s: sec}
       | select(.s != "" and .s != "direct")] as $cs
    | {g: ($m.g // ""),
       hosts: (reduce ($cs[] | select(.h != "")) as $c ($m.hosts; .[$c.h] = ((.[$c.h] // {}) + {s: $c.s, t: $t})) | trim),
       dsts: (reduce ($cs[] | select(.d != "" and (.d | fake | not))) as $c ($m.dsts; .[$c.d] = {s: $c.s, t: $t}) | trim)}
  ' "$1" > "$_sd/map.new" 2>/dev/null && mv "$_sd/map.new" "$_sd/map.json" || return 0
  # the FakeIP of hosts seen for the first time (podkop's DNS; a few per poll)
  jq -r '.hosts | to_entries[] | select(.value.f == null) | .key' "$_sd/map.json" | head -n 50 |
    while IFS= read -r _h; do
      case "$_h" in ""|*[!A-Za-z0-9._-]*) continue ;; esac
      _a=$(nslookup "$_h" 127.0.0.42 2>/dev/null | awk '/^Name:/ { n = 1; next } n && /^Address/ { sub(/^Address[^:]*: */, ""); sub(/ .*/, ""); print; exit }')
      case "$_a" in 198.18.*|198.19.*) printf '%s\t%s\n' "$_h" "$_a" ;; *) printf '%s\t-\n' "$_h" ;; esac
    done > "$_sd/fakes.tsv"
  [ -s "$_sd/fakes.tsv" ] || return 0
  jq -c --rawfile f "$_sd/fakes.tsv" '
    ($f | split("\n") | map(select(. != "") | split("\t") | {key: .[0], value: .[1]}) | from_entries) as $n
    | .hosts |= with_entries(if $n[.key] then .value.f = $n[.key] else . end)' "$_sd/map.json" > "$_sd/map.new" &&
    mv "$_sd/map.new" "$_sd/map.json"
}

# sections: stdin {"domains": [names], "addresses": [IPv4], "subnets": bool} ->
# {agent (its version), boot_id (of the FakeIP addresses, see sections_gen), sections, domains: {name: section}, addresses: {ip: {section, host}},
#  subnets: ["a.b.c.d/n" | "a.b.c.d-e.f.g.h"]}; only what the router knows.
cmd_sections() {
  _sd="$RUN/sections"; mkdir -p "$_sd"
  head -c 262144 > "$_sd/rq.$$"
  jq -e '((.domains // []) | type == "array" and length <= 500 and all(type == "string"))
         and ((.addresses // []) | type == "array" and length <= 500 and all(type == "string"))' "$_sd/rq.$$" >/dev/null 2>&1 ||
    { rm -f "$_sd/rq.$$"; fail bad_request 'expected {"domains": [...], "addresses": [...], "subnets": bool}, at most 500 of each'; }
  jq -e '.hosts and .dsts' "$_sd/map.json" >/dev/null 2>&1 || echo '{"hosts":{},"dsts":{}}' > "$_sd/map.json"
  if jq -e '.subnets == true' "$_sd/rq.$$" >/dev/null 2>&1; then
    nft -j list set inet PodkopTable podkop_subnets 2>/dev/null | jq -c '[.nftables[]? | select(.set) | .set.elem[]?
      | if type == "string" then . elif .prefix then "\(.prefix.addr)/\(.prefix.len)"
        elif .range then "\(.range[0])-\(.range[1])" else empty end]' > "$_sd/subnets.$$" 2>/dev/null
    [ -s "$_sd/subnets.$$" ] || echo '[]' > "$_sd/subnets.$$"
  else echo null > "$_sd/subnets.$$"; fi
  { seen_json 2>/dev/null || config_json 2>/dev/null; } |
    jq -c '[.sections[]? | select(.type == "section" and .name != "settings") | .name]' > "$_sd/names.$$" 2>/dev/null
  [ -s "$_sd/names.$$" ] || echo '[]' > "$_sd/names.$$"
  _g=$(sections_gen); [ -n "$_g" ] || _g=$(jq -r '.g // ""' "$_sd/map.json")
  [ -n "$_g" ] || _g=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
  _out=$(jq -nc --arg b "$_g" --arg v "${AGENT_VERSION:-}" \
      --slurpfile m "$_sd/map.json" --slurpfile rq "$_sd/rq.$$" --slurpfile sub "$_sd/subnets.$$" --slurpfile names "$_sd/names.$$" '
    $m[0] as $m | $rq[0] as $rq
    | ($m.hosts | to_entries | sort_by(.value.t)     # two names on one address: the one seen last has it
       | map(select((.value.f // "-") != "-") | {key: .value.f, value: {section: .value.s, host: .key}})
       | from_entries) as $fk
    | {agent: $v, boot_id: $b, sections: $names[0],
       domains: ([($rq.domains // [])[] | select($m.hosts[.]) | {key: ., value: $m.hosts[.].s}] | from_entries),
       addresses: ([($rq.addresses // [])[] | if $fk[.] then {key: ., value: $fk[.]}
                     elif $m.dsts[.] then {key: ., value: {section: $m.dsts[.].s, host: ""}} else empty end] | from_entries)}
    + (if $sub[0] == null then {} else {subnets: $sub[0]} end)')
  rm -f "$_sd/rq.$$" "$_sd/subnets.$$" "$_sd/names.$$"
  reply "$_out"
}

resolve_host() {
  case "$1" in *[!0-9.]*) ;; *) echo "$1"; return ;; esac
  for _ns in 77.88.8.8 8.8.8.8; do
    _a=$(nslookup "$1" "$_ns" 2>/dev/null | awk '/^Name:/ { n = 1; next } n && /^Address/ { sub(/^Address[^:]*: */, ""); sub(/ .*/, ""); if ($0 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) { print; exit } }')
    case "$_a" in ""|198.18.*|198.19.*) ;; *) echo "$_a"; return ;; esac
  done
}

# resolve: stdin {"hosts": [names]} -> {name: IPv4}, for the servers' networks
cmd_resolve() {
  _rq=$(head -c 65536)
  printf '%s' "$_rq" | jq -e '.hosts | type == "array" and length <= 400 and all(type == "string")' >/dev/null 2>&1 ||
    fail bad_request 'expected {"hosts": [...]}'
  reply "$(printf '%s' "$_rq" | jq -r '.hosts | unique | .[]' | while IFS= read -r _h; do
      case "$_h" in ""|*[!A-Za-z0-9.-]*) continue ;; esac
      _a=$(resolve_host "$_h"); [ -n "$_a" ] && printf '%s\t%s\n' "$_h" "$_a"
    done | jq -Rsc 'split("\n") | map(select(. != "") | split("\t") | {key: .[0], value: .[1]}) | from_entries')"
}

# devices: what is on the LAN, for the Devices page: DHCP leases, the fixed
# leases of /etc/config/dhcp and the neighbours seen on podkop's source
# interfaces (a device with an address of its own has no lease).
cmd_devices() {
  _ifs=$(uci -q get podkop.settings.source_network_interfaces); [ -n "$_ifs" ] || _ifs=br-lan
  {
    [ ! -r /tmp/dhcp.leases ] || awk '{ printf "lease\t%s\t%s\t%s\n", $3, $2, ($4 == "*" ? "" : $4) }' /tmp/dhcp.leases
    uci -q show dhcp 2>/dev/null | awk -F "'" '
      /^dhcp\.[^.]*=host$/ { flush(); sec = $0; sub(/=host$/, "", sec); next }
      sec != "" && index($0, sec ".ip=") == 1 { ip = $2 }
      sec != "" && index($0, sec ".mac=") == 1 { mac = $2 }
      sec != "" && index($0, sec ".name=") == 1 { name = $2 }
      function flush() { if (sec != "" && ip != "") printf "fixed\t%s\t%s\t%s\n", ip, tolower(mac), name; ip = mac = name = "" }
      END { flush() }'
    for _i in $_ifs; do
      ip -4 neigh show dev "$_i" 2>/dev/null | awk '$2 == "lladdr" && $NF != "FAILED" { printf "seen\t%s\t%s\t\n", $1, $3 }'
    done
  } | jq -Rsc 'split("\n") | map(select(. != "") | split("\t") | {kind: .[0], ip: .[1], mac: (.[2] // "" | ascii_downcase), name: (.[3] // "")})
      | map(select(.ip | length > 0)) | group_by(.ip)
      | map({ip: .[0].ip, mac: (map(.mac | select(. != "")) | first // ""), name: (map(.name | select(. != "")) | first // ""),
             fixed: any(.[]; .kind == "fixed"), lease: any(.[]; .kind == "lease")})' > "$RUN/devices.$$" 2>/dev/null
  _dv=$(cat "$RUN/devices.$$" 2>/dev/null); rm -f "$RUN/devices.$$"
  reply "$(jq -nc --argjson d "${_dv:-[]}" '{devices: $d}')"
}

# route: where a connection to a name or an address would go, read from the
# configuration sing-box runs now. Its rules are tried in their order, as
# sing-box does; a rule's lists are asked with sing-box's own "rule-set
# match". podkop's own lists are files in RAM already; a community list is
# downloaded to RAM (kept for a day), the way the kill switch gets its lists.
# {"target": "name or IPv4", "from": "a device's IPv4, optional"}
ROUTE_KEEP=86400
ROUTE_BUDGET=${PODKOP_ROUTE_BUDGET:-40}
route_list() {       # route_list <config> <tag> -> "<format>\t<file>" or nothing
  _rl=$(jq -r --arg t "$2" '.route.rule_set[]? | select(.tag == $t) | [.type, (.format // "binary"), (.path // .url // "")] | join("\t")' "$1" 2>/dev/null)
  IFS="$TAB" read -r _rt _rf _rp <<EOF_RL
$_rl
EOF_RL
  case "$_rt" in
    local) [ -s "$_rp" ] && printf '%s\t%s' "$_rf" "$_rp" ;;
    remote)
      _rc="$RUN/route/$(printf '%s' "$_rp" | md5sum | cut -c 1-16).$_rf"
      _ra=$(date -r "$_rc" +%s 2>/dev/null) || _ra=0
      # downloads share ROUTE_BUDGET seconds of one question, and a list that
      # did not come is not asked for again for ten minutes: the answer then
      # names the lists it could not read
      _rn=$(date +%s); _rb=$(date -r "$_rc.bad" +%s 2>/dev/null) || _rb=0
      if { [ ! -s "$_rc" ] || [ $((_rn - _ra)) -gt "$ROUTE_KEEP" ]; } && [ $((_rn - _rb)) -gt 600 ] &&
         [ $((_rn - ROUTE_T0)) -lt "$ROUTE_BUDGET" ]; then
        if command -v guard_fetch >/dev/null 2>&1; then guard_fetch "$_rp" "$_rc.t" < /dev/null
        else wget -q -T 30 -O "$_rc.t" "$_rp" 2>/dev/null; fi
        if [ -s "$_rc.t" ]; then mv "$_rc.t" "$_rc"; rm -f "$_rc.bad"; else rm -f "$_rc.t"; : > "$_rc.bad"; fi
      fi
      [ -s "$_rc" ] && printf '%s\t%s' "$_rf" "$_rc" ;;
  esac
}
route_match() { sing-box rule-set match -f "$1" "$2" "$3" 2>&1 | grep -q '^match'; }
cmd_route() {
  _rq=$(head -c 4096)
  _t=$(printf '%s' "$_rq" | jq -r '(.target // "") | ascii_downcase' 2>/dev/null)
  _from=$(printf '%s' "$_rq" | jq -r '.from // ""' 2>/dev/null)
  case "$_t" in ""|*[!a-z0-9._-]*|.*|*.) fail bad_request 'expected {"target": "a name or an IPv4 address"}' ;; esac
  case "$_from" in *[!0-9.]*) fail bad_request "from must be a device's IPv4 address" ;; esac
  _kind=domain; case "$_t" in *[!0-9.]*) ;; *.*.*.*) _kind=ip ;; esac
  _c=$(uci -q get podkop.settings.config_path); [ -n "$_c" ] || _c=/etc/sing-box/config.json
  [ -s "$_c" ] || fail not_running "sing-box has no configuration: podkop has not started yet"
  mkdir -p "$RUN/route"; ROUTE_T0=$(date +%s)
  # one line per routing rule: index, outbound, does the device fit, does an
  # entry written in the rule itself match, has it any destination, its lists
  jq -r --arg t "$_t" --arg k "$_kind" --arg from "$_from" '
    def lst: if type == "array" then . elif . == null then [] else [.] end;
    def num: split(".") | map(tonumber? // 0) | ((.[0] * 256 + .[1]) * 256 + .[2]) * 256 + .[3];
    def incidr($ip; $c): ($c | split("/")) as $p | (32 - (($p[1] // "32") | tonumber? // 32)) as $h
      | pow(2; $h) as $d | (($ip | num) / $d | floor) == (($p[0] | num) / $d | floor);
    .route.rules | to_entries[] | .key as $i | .value
    # block sections are "reject" rules, exclusions and never-routed devices go to direct-out
    | select(((.action // "route") == "route" and (.outbound // "") != "") or .action == "reject")
    | .outbound = (.outbound // "reject")
    | (.source_ip_cidr | lst) as $src
    | (if ($src | length) == 0 then true elif $from == "" then false
       else any($src[]; select(contains(":") | not) as $c | incidr($from; $c)) end) as $ok
    | (if $k == "domain" then (any(.domain | lst | .[]; ascii_downcase == $t)
          or any(.domain_suffix | lst | .[]; ascii_downcase | ltrimstr(".") as $s | $t == $s or ($t | endswith("." + $s))))
       else any(.ip_cidr | lst | .[]; select(contains(":") | not) as $c | incidr($t; $c)) end) as $own
    | [$i, .outbound, (if $ok then 1 else 0 end), (if $own then 1 else 0 end),
       (if ([.domain, .domain_suffix, .domain_keyword, .domain_regex, .ip_cidr, .rule_set] | map(lst | length) | add) > 0 then 1 else 0 end),
       (.rule_set | lst | join(" "))] | join("\t")' "$_c" > "$RUN/route/rules.$$" 2>/dev/null ||
    { rm -f "$RUN/route/rules.$$"; fail internal "cannot read sing-box's routing rules"; }
  _hit=""; _bad=""
  while IFS="$TAB" read -r _i _o _ok _own _dest _sets; do
    [ "$_ok" = 1 ] || continue
    if [ "$_own" = 1 ]; then _hit="$_i$TAB$_o$TAB"; break; fi
    if [ "$_dest" = 0 ]; then _hit="$_i$TAB$_o$TAB*"; break; fi
    for _s in $_sets; do
      _lf=$(route_list "$_c" "$_s")
      if [ -z "$_lf" ]; then _bad="$_bad $_s"; continue; fi
      if route_match "${_lf%%"$TAB"*}" "${_lf#*"$TAB"}" "$_t"; then _hit="$_i$TAB$_o$TAB$_s"; break 2; fi
    done
  done < "$RUN/route/rules.$$"
  rm -f "$RUN/route/rules.$$"
  # what the router itself says: a name podkop routes gets a FakeIP address
  # from the router's DNS; an address is routed only when podkop's nft sets hold it
  _dns=""; _set=""
  if [ "$_kind" = domain ]; then
    _dns=$(nslookup "$_t" 127.0.0.1 2>/dev/null | awk '/^Name:/ { n = 1; next } n && /^Address/ { sub(/^Address[^:]*: */, ""); sub(/ .*/, ""); if ($0 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) { print; exit } }')
  else
    for _ns in $(nft list sets inet 2>/dev/null | awk '$1 == "set" && $2 ~ /^podkop_/ { print $2 }'); do
      if nft get element inet PodkopTable "$_ns" "{ $_t }" >/dev/null 2>&1; then _set=$_ns; break; fi
    done
  fi
  _seen=null
  [ ! -s "$RUN/sections/map.json" ] || _seen=$(jq -c --arg t "$_t" '(.hosts[$t] // .dsts[$t]) as $x | if $x then {section: $x.s, t: ($x.t // null)} else null end' "$RUN/sections/map.json" 2>/dev/null) || _seen=null
  IFS="$TAB" read -r _hi _ho _hl <<EOF_RT
$_hit
EOF_RT
  reply "$(jq -nc --arg t "$_t" --arg k "$_kind" --arg from "$_from" --arg hi "${_hi:-}" --arg ho "${_ho:-}" --arg hl "${_hl:-}" \
    --arg bad "$_bad" --arg dns "$_dns" --arg set "$_set" --argjson seen "${_seen:-null}" \
    --arg fin "$(jq -r '.route.final // ""' "$_c" 2>/dev/null)" '
    {target: $t, kind: $k, from: $from,
     match: (if $ho == "" then null else {rule: ($hi | tonumber), outbound: $ho,
              list: (if $hl == "" or $hl == "*" then null else $hl end), every: ($hl == "*")} end),
     final: $fin, unread: ($bad | split(" ") | map(select(. != ""))),
     dns: (if $k == "domain" then {address: $dns, fakeip: ($dns | startswith("198.18.") or startswith("198.19."))} else null end),
     nft_set: (if $k == "ip" then $set else null end), seen: $seen}')"
}

# --- dispatch -----------------------------------------------------------------------

mkdir -p "$RUN/jobs" "$ETC" 2>/dev/null
# over SSH the command comes in SSH_ORIGINAL_COMMAND (forced command of the
# manager's key); the internal commands below are for procd and our own jobs
REMOTE=0
[ -n "${SSH_CONNECTION:-}" ] && REMOTE=1
if [ "${1:-}" = "--sections-only" ]; then
  # the VPN server's key: whatever it sends, only "sections" runs
  set -- sections
elif [ -n "${SSH_CONNECTION:-}" ]; then
  if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
    set -f
    # shellcheck disable=SC2086
    set -- $SSH_ORIGINAL_COMMAND
    set +f
    case "${1:-}" in podkop-agent|/usr/bin/podkop-agent) shift ;; esac
  fi
fi

_cmd=${1:-help}; [ $# -gt 0 ] && shift
# safe mode: nothing that restarts podkop, reloads sing-box or changes its config
case "$_cmd" in apply|pin|eligibility|heal-links|probe-start|strict)
  ! safe_mode || fail safe_mode "safe mode: the router runs plain podkop; leave safe mode first" ;;
esac
case "$_cmd" in
  diagnostics)   command -v cmd_diagnostics >/dev/null || fail unsupported "reinstall agent for diagnostics"; cmd_diagnostics ;;
  eligibility)   command -v cmd_eligibility >/dev/null || fail unsupported "reinstall agent for eligibility"; cmd_eligibility ;;
  heal)          command -v cmd_heal >/dev/null || fail unsupported "reinstall agent for self-heal"; cmd_heal ;;
  heal-off)      command -v cmd_heal_off >/dev/null || fail unsupported "reinstall agent for self-heal"; cmd_heal_off ;;
  heal-links)    command -v cmd_heal_links >/dev/null || fail unsupported "reinstall agent for self-heal"; cmd_heal_links ;;
  strict)        command -v cmd_strict >/dev/null || fail unsupported "reinstall agent for strict rules"; cmd_strict ;;
  resolve)       cmd_resolve ;;
  devices)       cmd_devices ;;
  route)         cmd_route ;;
  sections)      cmd_sections ;;
  ipv6)          cmd_ipv6 "$@" ;;
  dns-guard)     cmd_dns_guard "$@" ;;
  vpn)           cmd_vpn "$@" ;;
  zapret)        cmd_zapret "$@" ;;
  upgrade)       cmd_upgrade ;;
  safe-mode)     cmd_safe_mode "$@" ;;
  protect)       cmd_protect ;;
  status)        cmd_status ;;
  config-get)    cmd_config_get ;;
  validate)      cmd_validate ;;
  apply)         cmd_apply ;;
  job)           cmd_job "$@" ;;
  pin)           cmd_pin "$@" ;;
  proxies)       cmd_proxies ;;
  delays)        cmd_delays "$@" ;;
  exit-ip)       cmd_exit_ip "$@" ;;
  exit-ips)      cmd_exit_ips ;;
  logs)          cmd_logs "$@" ;;
  watch)         cmd_watch "$@" ;;
  service)       cmd_service "$@" ;;
  probe-start)   cmd_probe_start ;;
  probe-status)  cmd_probe_status ;;
  probe-config)  cmd_probe_config ;;
  probe-cron)    cmd_probe_cron "$@" ;;
  sub-info)      cmd_sub_info ;;
  probe-nodes)   cmd_probe_nodes ;;
  traffic)       cmd_traffic ;;
  uninstall)
    [ -f /usr/share/podkop-agent/install.sh ] || fail not_found "install.sh is not on the router"
    env -u SSH_ORIGINAL_COMMAND -u SSH_CONNECTION -u SSH_CLIENT \
      setsid sh -c 'sleep 2; sh /usr/share/podkop-agent/install.sh --uninstall' </dev/null >/dev/null 2>&1 &
    reply '{"uninstalling":true}' ;;
  version)       reply "$(jq -nc --arg v "$AGENT_VERSION" --argjson p "$PROTO" --argjson caps "$(capabilities)" \
                   '{version: $v, protocol: $p, capabilities: $caps}')" ;;
  daemon|_event|_run-apply|_run-probe|_run-upgrade|_run-vpn-install|_run-zapret-check|_zapret-nft|_zapret-run)
    [ "$REMOTE" = 0 ] || fail forbidden "$_cmd can't be run over SSH"
    case "$_cmd" in
      daemon) daemon ;;
      _event) event "${1:-}" "${2:-}" ;;        # podkop-sentinel's
      _run-vpn-install) run_vpn_install "$1" ;;
      _run-zapret-check) run_zapret_check "$1" ;;
      _zapret-nft) zapret_nft "${1:-on}" ;;
      _zapret-run) _zr=$(jq -c --arg r "${1:-}" '.[$r] // empty' "$ZAPRET_RULES" 2>/dev/null); [ -n "$_zr" ] || exit 1; zapret_exec "$_zr" ;;
      _run-apply) run_apply "$1" ;;
      _run-probe) run_probe ;;
      _run-upgrade) run_upgrade "$1" ;;
    esac ;;
  help|-h|--help)
    echo "podkop-agent $AGENT_VERSION: status config-get validate apply job pin proxies exit-ip exit-ips delays logs watch service probe-start probe-status probe-config probe-cron sub-info probe-nodes traffic sections diagnostics eligibility heal heal-off heal-links strict protect safe-mode resolve ipv6 vpn zapret upgrade uninstall version" ;;
  *) fail bad_request "unknown command $_cmd" ;;
esac
# end of podkop-agent
