# Copy to .env (cp .env.example .env; chmod 600 .env) and fill in.
# Keep the single quotes: then $, # and spaces in a password work.

# time zone for "today", daily limits and the nightly probe
TZ=Europe/Moscow

# port of the web interface on this server
PODKOP_MANAGER_PORT=8080

# web login: name and password (at least 8 characters)
PODKOP_MANAGER_USER='admin'
PODKOP_MANAGER_PASSWORD='change-me-please'

# behind a reverse proxy with HTTPS: the login cookie is then sent over HTTPS only
#PODKOP_MANAGER_HTTPS=1

# an uptime monitor's check-in URL (healthchecks.io, Uptime Kuma "push", ...): requested every
# minute while the manager works; the monitor raises the alarm when the requests stop
#PODKOP_MANAGER_HEARTBEAT_URL='https://hc-ping.com/your-check-id'

# a hung manager ends itself after 3 minutes and Docker starts it again; 0 switches that off
#PODKOP_MANAGER_WATCHDOG=0
